---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import Callout from '../../components/docs/Callout.astro';
import CodeTabs from '../../components/docs/CodeTabs.astro';
import ApiEndpoint from '../../components/docs/ApiEndpoint.astro';
import SyncFlowDiagram from '../../components/illustrations/SyncFlowDiagram.astro';
import CallMediaDiagram from '../../components/illustrations/CallMediaDiagram.astro';
import BotPlatformDiagram from '../../components/illustrations/BotPlatformDiagram.astro';
import SignatureVerifyDiagram from '../../components/illustrations/SignatureVerifyDiagram.astro';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  const enDocs = allDocs.filter((entry) => entry.id.startsWith('en/'));

  return enDocs.map((entry) => {
    const cleanSlug = entry.id.replace(/^en\//, '').replace(/\.(md|mdx)$/, '');
    return {
      params: { slug: cleanSlug },
      props: { entry, allDocs, cleanSlug },
    };
  });
}

const { entry, allDocs, cleanSlug } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
  entry={entry}
  allEntries={allDocs}
  headings={headings}
  locale="en"
  slug={cleanSlug}
>
  <Content components={{ Callout, CodeTabs, ApiEndpoint, SyncFlowDiagram, CallMediaDiagram, BotPlatformDiagram, SignatureVerifyDiagram }} />
</DocsLayout>
