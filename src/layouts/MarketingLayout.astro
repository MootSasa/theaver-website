---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocaleFromPath } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  headerMode?: 'marketing' | 'utility';
}

const { title, description, noindex = false, headerMode } = Astro.props;
const currentPath = Astro.url.pathname;
const locale = getLocaleFromPath(currentPath);
---

<BaseLayout title={title} description={description} noindex={noindex} canonicalPath={currentPath}>
  <div class="flex min-h-screen flex-col">
    <Header locale={locale} currentPath={currentPath} mode={headerMode} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </div>
</BaseLayout>
