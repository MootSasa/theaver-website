---
import MarketingLayout from './MarketingLayout.astro';
import { getLocaleFromPath, localizePath } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  updatedAt: string;
}

const { title, description, updatedAt } = Astro.props;
const currentPath = Astro.url.pathname;
const locale = getLocaleFromPath(currentPath);
const updatedLabel = locale === 'ru' ? 'Обновлено:' : 'Last updated:';

const legalLinks = [
  { href: localizePath('/privacy', locale), label: locale === 'ru' ? 'Конфиденциальность' : 'Privacy Policy' },
  { href: localizePath('/terms', locale), label: locale === 'ru' ? 'Условия использования' : 'Terms of Service' },
  { href: localizePath('/security', locale), label: locale === 'ru' ? 'Безопасность' : 'Security' },
  { href: localizePath('/delete-account', locale), label: locale === 'ru' ? 'Удаление аккаунта' : 'Delete Account' },
];
---

<MarketingLayout title={`${title} — Theaver`} description={description}>
  <section class="py-12 sm:py-16">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <div class="mb-8 border-b border-[var(--border-hairline)] pb-6">
          <p class="font-mono text-[12px] text-[var(--text-muted)]">
            {updatedLabel} {updatedAt}
          </p>
          <h1 class="mt-2 text-[32px] font-semibold leading-[1.15] text-[var(--text-primary)] sm:text-[36px]">
            {title}
          </h1>
          <nav aria-label={locale === 'ru' ? 'Правовые документы' : 'Legal documents'} class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px] text-[var(--text-secondary)]">
            {legalLinks.map((item, idx) => {
              const active = currentPath.replace(/\/+$/, '') === item.href.replace(/\/+$/, '');
              return (
                <>
                  {idx > 0 && <span aria-hidden="true" class="text-[var(--text-muted)]">·</span>}
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'hover:text-[var(--accent)]',
                      active && 'font-semibold text-[var(--accent)]',
                    ]}
                  >
                    {item.label}
                  </a>
                </>
              );
            })}
          </nav>
        </div>

        <article class="docs-prose">
          <slot />
        </article>
      </div>
    </div>
  </section>
</MarketingLayout>
