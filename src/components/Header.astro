---
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSelect from './LanguageSelect.astro';
import SearchDialog from './SearchDialog.astro';
import { UI_STRINGS, localizePath, type Locale } from '../lib/i18n';
import { GITHUB_REPO_URL, WEB_APP_URL } from '../lib/releases';

interface Props {
  locale: Locale;
  currentPath: string;
  mode?: 'marketing' | 'utility';
}

const { locale, currentPath, mode } = Astro.props;
const cleanPath = currentPath.replace(/\/+$/, '') || '/';
const isUtilityRoute =
  cleanPath.startsWith('/docs') ||
  cleanPath.startsWith('/ru/docs') ||
  cleanPath.startsWith('/developers') ||
  cleanPath.startsWith('/ru/developers') ||
  cleanPath.startsWith('/privacy') ||
  cleanPath.startsWith('/ru/privacy') ||
  cleanPath.startsWith('/terms') ||
  cleanPath.startsWith('/ru/terms') ||
  cleanPath.startsWith('/security') ||
  cleanPath.startsWith('/ru/security') ||
  cleanPath.startsWith('/delete-account') ||
  cleanPath.startsWith('/ru/delete-account');

const resolvedMode: 'marketing' | 'utility' = mode ?? (isUtilityRoute ? 'utility' : 'marketing');

const t = UI_STRINGS[locale].nav;
const homeHref = localizePath('/', locale);
const downloadsHref = localizePath('/downloads', locale);
const docsHref = localizePath('/docs', locale);
const devsHref = localizePath('/developers/apps', locale);
const changelogHref = localizePath('/changelog', locale);
const ruEquivalent = localizePath(currentPath, 'ru');

const norm = (href: string) => href.replace(/\/+$/, '') || '/';
const isDownloadsActive = cleanPath === norm(downloadsHref);
const isDocsActive = cleanPath === norm(docsHref) || cleanPath.startsWith(`${norm(docsHref)}/`);
const isDevsActive = cleanPath === norm(devsHref) || cleanPath.startsWith('/developers') || cleanPath.startsWith('/ru/developers');
const isChangelogActive = cleanPath === norm(changelogHref);
const isFeaturesActive = !isDownloadsActive && !isDocsActive && !isDevsActive && !isChangelogActive && (cleanPath === '/' || cleanPath === '/ru');

const navItems = [
  { href: `${homeHref}#features`, label: t.features, active: isFeaturesActive },
  { href: downloadsHref, label: t.downloads, active: isDownloadsActive },
  { href: docsHref, label: t.docs, active: isDocsActive },
  { href: devsHref, label: t.developers, active: isDevsActive },
  { href: changelogHref, label: t.changelog, active: isChangelogActive },
];
---

<header
  data-header-mode={resolvedMode}
  data-nav-fit="wide"
  class:list={[
    'theaver-header z-40 text-[var(--nav-text)]',
    resolvedMode === 'marketing'
      ? 'theaver-header-marketing fixed inset-x-0 top-0 pointer-events-none'
      : 'theaver-header-utility sticky top-0',
  ]}
>
  {resolvedMode === 'marketing' && <div class="header-dock-bg" aria-hidden="true"></div>}

  <div
    class:list={[
      'theaver-header-capsule pointer-events-auto relative mx-auto flex h-12 items-center justify-between gap-3 px-4 sm:px-5',
      resolvedMode === 'marketing' ? 'w-[min(calc(100%-24px),1180px)]' : 'w-full max-w-[1280px]',
    ]}
  >
    {resolvedMode === 'marketing' && <div class="header-pill-bg" aria-hidden="true"></div>}

    <div class="header-primary-group relative z-10 flex shrink-0 items-center gap-3 lg:gap-4">
      <a href={homeHref} class="brand-logo-link inline-flex shrink-0 items-center gap-2 whitespace-nowrap text-[var(--nav-text)]">
        <BrandMark size={22} />
        <span class="text-[13.5px] font-semibold tracking-[-0.01em]">Theaver</span>
      </a>

      <nav aria-label="Main navigation" class="header-inline-nav">
        <ul class="nav-links relative flex items-center gap-0.5 whitespace-nowrap">
          {navItems.map((item) => (
            <li class:list={[item.active && 'active']}>
              <a
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
                class:list={[
                  'inline-flex items-center rounded-[6px] px-2.5 py-1 text-[12px] tracking-[-0.01em] transition-colors duration-150',
                  item.active ? 'font-semibold text-[var(--nav-text)]' : 'text-[var(--nav-muted)] hover:text-[var(--nav-text)]',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a
              href={GITHUB_REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 rounded-[6px] px-2.5 py-1 text-[12px] tracking-[-0.01em] text-[var(--nav-muted)] transition-colors duration-150 hover:text-[var(--nav-text)]"
            >
              <Icon name="github" size={14} />
              <span>{t.github}</span>
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="header-actions-group relative z-10 flex shrink-0 items-center gap-1.5 whitespace-nowrap">
      <button
        type="button"
        data-open-search
        aria-label={t.searchButton}
        class="inline-flex h-7 w-7 shrink-0 items-center justify-center gap-1.5 rounded-[7px] border border-[var(--nav-chip-border)] bg-[var(--nav-chip-bg)] text-[12px] text-[var(--nav-muted)] transition-colors duration-150 hover:bg-[var(--nav-chip-hover)] hover:text-[var(--nav-text)] active:scale-95 xl:w-auto xl:px-2"
      >
        <Icon name="search" size={14} />
        <span class="hidden xl:inline">{t.searchButton}</span>
        <kbd class="hidden rounded-[4px] border border-[var(--nav-chip-border)] bg-[var(--nav-chip-bg)] px-1 py-px font-mono text-[10px] leading-none text-[var(--nav-muted)] xl:inline-flex">⌘K</kbd>
      </button>

      <LanguageSelect locale={locale} currentPath={currentPath} variant="nav" />
      <ThemeToggle locale={locale} variant="nav" />

      <a
        href={WEB_APP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="header-open-web whitespace-nowrap px-2 text-[12px] tracking-[-0.01em] text-[var(--nav-muted)] transition-colors duration-150 hover:text-[var(--nav-text)]"
      >
        {t.openWeb}
      </a>

      <a
        href={downloadsHref}
        class="hidden h-7 shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full bg-[#00558f] px-3 text-[12px] font-semibold tracking-[-0.01em] text-white transition-[background-color,transform] duration-150 hover:bg-[#006bb3] active:scale-95 sm:inline-flex"
      >
        <Icon name="download" size={13} />
        <span>{t.download}</span>
      </a>

      <button
        type="button"
        id="mobile-menu-open"
        aria-label="Open menu"
        class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-[7px] border border-[var(--nav-chip-border)] bg-[var(--nav-chip-bg)] text-[var(--nav-text)] hover:bg-[var(--nav-chip-hover)]"
      >
        <Icon name="menu" size={17} />
      </button>
    </div>
  </div>
</header>

{resolvedMode === 'marketing' && (
  <div class="h-12 shrink-0" aria-hidden="true"></div>
)}

{locale === 'en' && (
  <div
    id="lang-suggest-banner"
    class="hidden border-b border-[var(--border-hairline)] bg-[var(--bg-alt)] px-4 py-2 text-[12.5px] text-[var(--text-secondary)]"
  >
    <div class="container-wide flex flex-wrap items-center justify-between gap-3 px-0">
      <span>{t.langBannerText}</span>
      <div class="flex items-center gap-3">
        <a
          href={ruEquivalent}
          class="font-semibold text-[var(--accent)] hover:underline"
        >
          {t.langBannerAction}
        </a>
        <button
          type="button"
          id="lang-suggest-dismiss"
          class="text-[var(--text-muted)] hover:text-[var(--text-primary)]"
        >
          {t.langBannerDismiss}
        </button>
      </div>
    </div>
  </div>
)}

<dialog
  id="mobile-nav-dialog"
  closedby="any"
  aria-label="Mobile navigation"
  class="top-layer-dialog m-0 ml-auto h-full max-h-none w-[min(320px,86vw)] border-l border-[var(--border-hairline)] bg-[var(--bg-page)] p-5 text-[var(--text-primary)] backdrop:bg-black/60"
>
  <div class="flex h-full flex-col justify-between">
    <div>
      <div class="flex items-center justify-between border-b border-[var(--border-hairline)] pb-4">
        <span class="inline-flex items-center gap-2 text-[16px] font-semibold">
          <BrandMark size={24} />
          <span>Theaver</span>
        </span>
        <button
          type="button"
          id="mobile-menu-close"
          aria-label="Close menu"
          class="inline-flex h-9 w-9 items-center justify-center rounded-[8px] border border-[var(--border-hairline)] bg-[var(--bg-card)] text-[var(--text-secondary)]"
        >
          <Icon name="close" size={16} />
        </button>
      </div>
      <nav aria-label="Mobile sections" class="mt-4 flex flex-col gap-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            data-mobile-nav-link
            aria-current={item.active ? 'page' : undefined}
            class:list={[
              'rounded-[8px] px-3 py-2.5 text-[15px] hover:bg-[var(--bg-raised)]',
              item.active ? 'font-semibold text-[var(--accent)]' : 'text-[var(--text-primary)]',
            ]}
          >
            {item.label}
          </a>
        ))}
        <a
          href={GITHUB_REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-[8px] px-3 py-2.5 text-[15px] text-[var(--text-secondary)] hover:bg-[var(--bg-raised)]"
        >
          {t.github}
        </a>
      </nav>
    </div>

    <div class="flex flex-col gap-2 border-t border-[var(--border-hairline)] pt-4">
      <a href={downloadsHref} class="btn-primary w-full">
        <Icon name="download" size={16} />
        <span>{t.download}</span>
      </a>
      <a href={WEB_APP_URL} target="_blank" rel="noopener noreferrer" class="btn-secondary w-full">
        {t.openWeb}
      </a>
    </div>
  </div>
</dialog>

<SearchDialog locale={locale} />

<style is:global>
  /* Theme-aware surface & ink variables for header chrome */
  .theaver-header {
    --nav-dock-bg: rgba(12, 12, 14, 0.84);
    --nav-pill-bg: rgba(20, 20, 24, 0.88);
    --nav-border: rgba(255, 255, 255, 0.12);
    --nav-text: #f5f5f7;
    --nav-muted: #d2d2d7;
    --nav-chip-bg: rgba(255, 255, 255, 0.08);
    --nav-chip-border: rgba(255, 255, 255, 0.14);
    --nav-chip-hover: rgba(255, 255, 255, 0.15);
    --nav-indicator: #ffb37f;
  }

  html[data-theme="light"] .theaver-header {
    --nav-dock-bg: rgba(255, 255, 255, 0.86);
    --nav-pill-bg: rgba(255, 255, 255, 0.92);
    --nav-border: rgba(0, 0, 0, 0.10);
    --nav-text: #1d1d1f;
    --nav-muted: #424245;
    --nav-chip-bg: rgba(0, 0, 0, 0.045);
    --nav-chip-border: rgba(0, 0, 0, 0.10);
    --nav-chip-hover: rgba(0, 0, 0, 0.09);
    --nav-indicator: #00558f;
  }

  .theaver-header-utility {
    background-color: var(--nav-dock-bg);
    border-bottom: 1px solid var(--nav-border);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
  }

  /* Keep natural inline row measurable without premature wrapping */
  .theaver-header-capsule > * {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .theaver-header.is-measuring * {
    transition: none !important;
  }

  .header-inline-nav {
    display: block;
  }

  .header-open-web {
    display: inline-flex;
  }

  #mobile-menu-open {
    display: none;
  }

  @media (max-width: 1023.98px) {
    .header-inline-nav,
    .header-open-web {
      display: none;
    }

    #mobile-menu-open {
      display: inline-flex;
    }
  }

  .theaver-header[data-nav-fit="compact"] .header-inline-nav,
  .theaver-header[data-nav-fit="compact"] .header-open-web {
    display: none;
  }

  .theaver-header[data-nav-fit="compact"] #mobile-menu-open {
    display: inline-flex;
  }

  /* Anchor-positioned active nav underline with progressive enhancement + forced-colors border */
  ul.nav-links li {
    position: relative;
  }

  ul.nav-links li.active {
    anchor-name: --active-nav;
  }

  ul.nav-links::before {
    content: "";
    position: absolute;
    position-anchor: --active-nav;
    inset-block-start: anchor(bottom);
    inset-inline-start: anchor(start);
    inset-inline-end: anchor(end);
    border-block-end: 2px solid var(--nav-indicator);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    ul.nav-links::before {
      transition: inset 0.2s var(--ease-standard);
    }
  }

  @supports not (position-anchor: --active-nav) {
    ul.nav-links::before {
      content: none;
    }

    ul.nav-links li.active {
      border-block-end: 2px solid var(--nav-indicator);
    }
  }

  /* Marketing top bar -> floating capsule morph using compositor properties only */
  .theaver-header-marketing .header-dock-bg {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 48px;
    background-color: var(--nav-dock-bg);
    border-bottom: 1px solid var(--nav-border);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    pointer-events: none;
    z-index: 0;
  }

  .theaver-header-marketing .header-pill-bg {
    position: absolute;
    inset: 2px 0;
    border-radius: 9999px;
    background-color: var(--nav-pill-bg);
    border: 1px solid var(--nav-border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    opacity: 0;
    pointer-events: none;
    z-index: 1;
  }

  @keyframes theaver-dock-fade {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes theaver-capsule-drop {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, 8px, 0);
    }
  }

  @keyframes theaver-pill-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
      .theaver-header-marketing .header-dock-bg {
        animation: theaver-dock-fade auto linear both;
        animation-timeline: scroll(block root);
        animation-range: 0px 110px;
      }

      .theaver-header-marketing .theaver-header-capsule {
        animation: theaver-capsule-drop auto linear both;
        animation-timeline: scroll(block root);
        animation-range: 0px 110px;
      }

      .theaver-header-marketing .header-pill-bg {
        animation: theaver-pill-fade auto linear both;
        animation-timeline: scroll(block root);
        animation-range: 0px 110px;
      }
    }
  }
</style>

<script is:inline>
  (() => {
    const banner = document.getElementById('lang-suggest-banner');
    const dismiss = document.getElementById('lang-suggest-dismiss');
    if (banner && dismiss) {
      const dismissed = localStorage.getItem('theaver-lang-banner-dismissed') === '1';
      const lang = (navigator.language || '').toLowerCase();
      if (!dismissed && lang.startsWith('ru')) {
        banner.classList.remove('hidden');
      }
      dismiss.addEventListener('click', () => {
        localStorage.setItem('theaver-lang-banner-dismissed', '1');
        banner.classList.add('hidden');
      });
    }

    const mobileDialog = document.getElementById('mobile-nav-dialog');
    const openBtn = document.getElementById('mobile-menu-open');
    const closeBtn = document.getElementById('mobile-menu-close');
    if (mobileDialog instanceof HTMLDialogElement && openBtn && closeBtn) {
      const closeMobile = () => {
        if (window.__theaverCloseTopLayer) {
          void window.__theaverCloseTopLayer(mobileDialog);
        } else {
          mobileDialog.close();
        }
      };
      openBtn.addEventListener('click', () => mobileDialog.showModal());
      closeBtn.addEventListener('click', closeMobile);
      mobileDialog.querySelectorAll('[data-mobile-nav-link]').forEach((el) => {
        el.addEventListener('click', closeMobile);
      });
    }

    // Intrinsic inline-vs-compact navigation fit measurement (prevents overflow across locales)
    const header = document.querySelector('header.theaver-header');
    const capsule = header?.querySelector('.theaver-header-capsule');
    const navList = header?.querySelector('.nav-links');
    if (header instanceof HTMLElement && capsule instanceof HTMLElement) {
      let lastCompactWidth = 0;

      const measureHeaderFit = () => {
        if (window.innerWidth < 1024) {
          header.dataset.navFit = 'compact';
          lastCompactWidth = 0;
          return;
        }
        const currentWidth = capsule.clientWidth;
        if (header.dataset.navFit === 'compact' && currentWidth <= lastCompactWidth) {
          return;
        }

        header.classList.add('is-measuring');
        header.dataset.navFit = 'wide';
        const fits = capsule.scrollWidth <= capsule.clientWidth;
        header.dataset.navFit = fits ? 'wide' : 'compact';
        lastCompactWidth = fits ? 0 : capsule.clientWidth;
        requestAnimationFrame(() => header.classList.remove('is-measuring'));
      };

      const ro = new ResizeObserver(measureHeaderFit);
      ro.observe(header);
      ro.observe(capsule);
      if (navList instanceof HTMLElement) ro.observe(navList);
      window.addEventListener('resize', measureHeaderFit, { passive: true });
      if (document.fonts && document.fonts.ready) {
        void document.fonts.ready.then(measureHeaderFit);
      }
      measureHeaderFit();
    }

    // Compositor-only scroll fallback for browsers without animation-range support
    const marketingHeader = document.querySelector('.theaver-header-marketing');
    if (
      marketingHeader &&
      !CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)') &&
      window.matchMedia('(prefers-reduced-motion: no-preference)').matches
    ) {
      const dock = marketingHeader.querySelector('.header-dock-bg');
      const cap = marketingHeader.querySelector('.theaver-header-capsule');
      const pill = marketingHeader.querySelector('.header-pill-bg');
      const updateHeader = () => {
        const p = Math.min(1, Math.max(0, window.scrollY / 110));
        if (dock instanceof HTMLElement) {
          dock.style.opacity = String(1 - p);
        }
        if (cap instanceof HTMLElement) {
          cap.style.transform = `translate3d(0, ${8 * p}px, 0)`;
        }
        if (pill instanceof HTMLElement) {
          pill.style.opacity = String(p);
        }
      };
      window.addEventListener('scroll', updateHeader, { passive: true });
      window.addEventListener('resize', updateHeader, { passive: true });
      updateHeader();
    }
  })();
</script>
