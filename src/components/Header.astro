---
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSelect from './LanguageSelect.astro';
import SearchDialog from './SearchDialog.astro';
import { UI_STRINGS, localizePath, type Locale } from '../lib/i18n';
import { GITHUB_REPO_URL, WEB_APP_URL } from '../lib/releases';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const t = UI_STRINGS[locale].nav;
const homeHref = localizePath('/', locale);
const downloadsHref = localizePath('/downloads', locale);
const docsHref = localizePath('/docs/guide/getting-started', locale);
const changelogHref = localizePath('/changelog', locale);
const ruEquivalent = localizePath(currentPath, 'ru');
---

{locale === 'en' && (
  <div
    id="lang-suggest-banner"
    class="hidden border-b border-[var(--border-hairline)] bg-[var(--bg-alt)] px-4 py-2 text-[12.5px] text-[var(--text-secondary)]"
  >
    <div class="container-wide flex flex-wrap items-center justify-between gap-3 px-0">
      <span>{t.langBannerText}</span>
      <div class="flex items-center gap-3">
        <a
          href={ruEquivalent}
          class="font-semibold text-[var(--accent)] hover:underline"
        >
          {t.langBannerAction}
        </a>
        <button
          type="button"
          id="lang-suggest-dismiss"
          class="text-[var(--text-muted)] hover:text-[var(--text-primary)]"
        >
          {t.langBannerDismiss}
        </button>
      </div>
    </div>
  </div>
)}

<header class="sticky top-0 z-40 border-b border-white/[0.08] bg-[rgba(12,12,14,0.84)] text-[#f5f5f7] backdrop-blur-xl backdrop-saturate-[180%]">
  <div class="container-wide flex h-11 items-center justify-between gap-3">
    <div class="flex min-w-0 items-center gap-5">
      <a href={homeHref} class="inline-flex shrink-0 items-center gap-2 text-white">
        <BrandMark size={22} />
        <span class="text-[13.5px] font-semibold tracking-[-0.01em]">Theaver</span>
      </a>

      <nav aria-label="Main navigation" class="hidden items-center gap-1 whitespace-nowrap md:flex">
        <a
          href={`${homeHref}#features`}
          class="rounded-[6px] px-2.5 py-1 text-[12px] tracking-[-0.01em] text-[#d2d2d7] transition-colors duration-150 hover:text-white"
        >
          {t.features}
        </a>
        <a
          href={downloadsHref}
          class="rounded-[6px] px-2.5 py-1 text-[12px] tracking-[-0.01em] text-[#d2d2d7] transition-colors duration-150 hover:text-white"
        >
          {t.downloads}
        </a>
        <a
          href={docsHref}
          class="rounded-[6px] px-2.5 py-1 text-[12px] tracking-[-0.01em] text-[#d2d2d7] transition-colors duration-150 hover:text-white"
        >
          {t.docs}
        </a>
        <a
          href={changelogHref}
          class="rounded-[6px] px-2.5 py-1 text-[12px] tracking-[-0.01em] text-[#d2d2d7] transition-colors duration-150 hover:text-white"
        >
          {t.changelog}
        </a>
        <a
          href={GITHUB_REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 rounded-[6px] px-2.5 py-1 text-[12px] tracking-[-0.01em] text-[#d2d2d7] transition-colors duration-150 hover:text-white"
        >
          <Icon name="github" size={14} />
          <span>{t.github}</span>
        </a>
      </nav>
    </div>

    <div class="flex shrink-0 items-center gap-1.5 whitespace-nowrap">
      <button
        type="button"
        data-open-search
        aria-label={t.searchButton}
        class="inline-flex h-7 w-7 items-center justify-center gap-1.5 rounded-[7px] border border-white/15 bg-white/[0.08] text-[12px] text-[#d2d2d7] transition-colors duration-150 hover:bg-white/[0.14] hover:text-white active:scale-95 sm:w-auto sm:px-2"
      >
        <Icon name="search" size={14} />
        <span class="hidden lg:inline">{t.searchButton}</span>
        <kbd class="hidden rounded-[4px] border border-white/15 bg-white/10 px-1 py-px font-mono text-[10px] leading-none text-[#a1a1a6] lg:inline-flex">⌘K</kbd>
      </button>

      <LanguageSelect locale={locale} currentPath={currentPath} variant="nav" />
      <ThemeToggle locale={locale} variant="nav" />

      <a
        href={WEB_APP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden whitespace-nowrap px-2 text-[12px] tracking-[-0.01em] text-[#d2d2d7] transition-colors duration-150 hover:text-white sm:inline-flex"
      >
        {t.openWeb}
      </a>

      <a
        href={downloadsHref}
        class="hidden h-7 items-center gap-1.5 whitespace-nowrap rounded-full bg-[#00558f] px-3 text-[12px] font-normal tracking-[-0.01em] text-white transition-all duration-150 hover:bg-[#006bb3] active:scale-95 sm:inline-flex"
      >
        <Icon name="download" size={13} />
        <span>{t.download}</span>
      </a>

      <button
        type="button"
        id="mobile-menu-open"
        aria-label="Open menu"
        class="inline-flex h-8 w-8 items-center justify-center rounded-[7px] border border-white/15 bg-white/[0.08] text-white md:hidden"
      >
        <Icon name="menu" size={17} />
      </button>
    </div>
  </div>
</header>

<dialog
  id="mobile-nav-dialog"
  closedby="any"
  aria-label="Mobile navigation"
  class="m-0 ml-auto h-full max-h-none w-[min(320px,86vw)] border-l border-[var(--border-hairline)] bg-[var(--bg-page)] p-5 text-[var(--text-primary)] backdrop:bg-black/60"
>
  <div class="flex h-full flex-col justify-between">
    <div>
      <div class="flex items-center justify-between border-b border-[var(--border-hairline)] pb-4">
        <span class="inline-flex items-center gap-2 text-[16px] font-semibold">
          <img src="/app-icon.png" alt="" width="24" height="24" class="h-6 w-6 rounded-[6px]" />
          <span>Theaver</span>
        </span>
        <button
          type="button"
          id="mobile-menu-close"
          aria-label="Close menu"
          class="inline-flex h-9 w-9 items-center justify-center rounded-[8px] border border-[var(--border-hairline)] bg-[var(--bg-card)] text-[var(--text-secondary)]"
        >
          <Icon name="close" size={16} />
        </button>
      </div>
      <nav class="mt-4 flex flex-col gap-1">
        <a href={`${homeHref}#features`} data-mobile-nav-link class="rounded-[8px] px-3 py-2.5 text-[15px] text-[var(--text-primary)] hover:bg-[var(--bg-raised)]">
          {t.features}
        </a>
        <a href={downloadsHref} data-mobile-nav-link class="rounded-[8px] px-3 py-2.5 text-[15px] text-[var(--text-primary)] hover:bg-[var(--bg-raised)]">
          {t.downloads}
        </a>
        <a href={docsHref} data-mobile-nav-link class="rounded-[8px] px-3 py-2.5 text-[15px] text-[var(--text-primary)] hover:bg-[var(--bg-raised)]">
          {t.docs}
        </a>
        <a href={changelogHref} data-mobile-nav-link class="rounded-[8px] px-3 py-2.5 text-[15px] text-[var(--text-primary)] hover:bg-[var(--bg-raised)]">
          {t.changelog}
        </a>
        <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer" class="rounded-[8px] px-3 py-2.5 text-[15px] text-[var(--text-secondary)] hover:bg-[var(--bg-raised)]">
          {t.github}
        </a>
      </nav>
    </div>

    <div class="flex flex-col gap-2 border-t border-[var(--border-hairline)] pt-4">
      <a href={downloadsHref} class="btn-primary w-full">
        <Icon name="download" size={16} />
        <span>{t.download}</span>
      </a>
      <a href={WEB_APP_URL} target="_blank" rel="noopener noreferrer" class="btn-secondary w-full">
        {t.openWeb}
      </a>
    </div>
  </div>
</dialog>

<SearchDialog locale={locale} />

<script is:inline>
  (() => {
    const banner = document.getElementById('lang-suggest-banner');
    const dismiss = document.getElementById('lang-suggest-dismiss');
    if (banner && dismiss) {
      const dismissed = localStorage.getItem('theaver-lang-banner-dismissed') === '1';
      const lang = (navigator.language || '').toLowerCase();
      if (!dismissed && lang.startsWith('ru')) {
        banner.classList.remove('hidden');
      }
      dismiss.addEventListener('click', () => {
        localStorage.setItem('theaver-lang-banner-dismissed', '1');
        banner.classList.add('hidden');
      });
    }

    const mobileDialog = document.getElementById('mobile-nav-dialog');
    const openBtn = document.getElementById('mobile-menu-open');
    const closeBtn = document.getElementById('mobile-menu-close');
    if (mobileDialog instanceof HTMLDialogElement && openBtn && closeBtn) {
      openBtn.addEventListener('click', () => mobileDialog.showModal());
      closeBtn.addEventListener('click', () => mobileDialog.close());
      mobileDialog.querySelectorAll('[data-mobile-nav-link]').forEach((el) => {
        el.addEventListener('click', () => mobileDialog.close());
      });
      if (!('closedBy' in HTMLDialogElement.prototype)) {
        mobileDialog.addEventListener('click', (event) => {
          if (event.target !== mobileDialog) return;
          const rect = mobileDialog.getBoundingClientRect();
          const inside =
            rect.top <= event.clientY &&
            event.clientY <= rect.top + rect.height &&
            rect.left <= event.clientX &&
            event.clientX <= rect.left + rect.width;
          if (!inside) mobileDialog.close();
        });
      }
    }
  })();
</script>
