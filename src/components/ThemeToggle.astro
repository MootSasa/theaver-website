---
import Icon from './Icon.astro';
import { UI_STRINGS, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  variant?: 'nav' | 'default';
}

const { locale, variant = 'default' } = Astro.props;
const t = UI_STRINGS[locale].theme;
const btnClasses =
  variant === 'nav'
    ? 'inline-flex h-7 items-center gap-1.5 rounded-[7px] border border-white/15 bg-white/[0.08] px-2 text-[12px] font-normal text-[#d2d2d7] transition-colors duration-150 hover:bg-white/[0.14] hover:text-white active:scale-95'
    : 'inline-flex h-9 items-center gap-2 rounded-[var(--radius-control)] border border-[var(--border-hairline)] bg-[var(--bg-card)] px-2.5 text-[13px] font-normal text-[var(--text-secondary)] transition-colors duration-150 hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]';
---

<button
  type="button"
  data-theme-toggle
  class={btnClasses}
  aria-label={t.toggleLabel}
  title={t.toggleLabel}
>
  <span data-theme-icon="system" class="inline-flex items-center">
    <Icon name="monitor" size={14} />
  </span>
  <span data-theme-icon="dark" class="hidden items-center">
    <Icon name="moon" size={14} />
  </span>
  <span data-theme-icon="light" class="hidden items-center">
    <Icon name="sun" size={14} />
  </span>
  <span
    class="hidden sm:inline"
    data-theme-label
    data-label-system={t.system}
    data-label-dark={t.dark}
    data-label-light={t.light}
  >
    {t.system}
  </span>
</button>

<script is:inline>
  (() => {
    if (window.__theaverThemeInit) return;
    window.__theaverThemeInit = true;

    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    const motionOk = () => window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

    function applyTheme(pref) {
      const resolved = pref === 'light' || pref === 'dark' ? pref : mq.matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = resolved;
      document.documentElement.dataset.themePref = pref;
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
        btn.querySelectorAll('[data-theme-icon]').forEach((el) => {
          const on = el.getAttribute('data-theme-icon') === pref;
          el.classList.toggle('hidden', !on);
          el.classList.toggle('inline-flex', on);
        });
        const lbl = btn.querySelector('[data-theme-label]');
        if (lbl) {
          lbl.textContent = lbl.getAttribute(`data-label-${pref}`) || pref;
        }
      });
    }

    const initial = localStorage.getItem('theaver-theme') || 'system';
    applyTheme(initial);

    mq.addEventListener('change', () => {
      if ((localStorage.getItem('theaver-theme') || 'system') === 'system') {
        applyTheme('system');
      }
    });

    document.addEventListener('click', (e) => {
      const btn = e.target instanceof Element ? e.target.closest('[data-theme-toggle]') : null;
      if (!btn) return;

      const curResolved = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      const curPref = localStorage.getItem('theaver-theme') || 'system';
      let next;
      if (curPref === 'system') {
        next = curResolved === 'dark' ? 'light' : 'dark';
      } else if (curPref === 'light') {
        next = mq.matches ? 'system' : 'dark';
      } else {
        next = !mq.matches ? 'system' : 'light';
      }
      localStorage.setItem('theaver-theme', next);

      const rect = btn.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const maxR = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      );

      if (typeof document.startViewTransition === 'function' && motionOk()) {
        const root = document.documentElement;
        root.style.setProperty('--vt-x', `${Math.round(x)}px`);
        root.style.setProperty('--vt-y', `${Math.round(y)}px`);
        root.style.setProperty('--vt-r', `${Math.ceil(maxR)}px`);
        root.setAttribute('data-theme-transitioning', '');
        const transition = document.startViewTransition(() => {
          applyTheme(next);
        });
        transition.finished.finally(() => {
          root.removeAttribute('data-theme-transitioning');
        });
      } else {
        applyTheme(next);
      }
    });
  })();
</script>
