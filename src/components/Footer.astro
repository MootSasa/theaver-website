---
import { UI_STRINGS, localizePath, type Locale } from '../lib/i18n';
import { GITHUB_REPO_URL, WEB_APP_URL } from '../lib/releases';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI_STRINGS[locale].footer;
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border-hairline)] bg-[var(--bg-deep)] py-14">
  <div class="container-page">
    <div class="grid gap-10 md:grid-cols-5">
      <div class="md:col-span-2">
        <a href={localizePath('/', locale)} class="inline-flex items-center gap-2.5">
          <img src="/app-icon.png" alt="Theaver" width="26" height="26" class="h-6 w-6 rounded-[6px]" loading="lazy" />
          <span class="text-[15px] font-semibold text-[var(--text-primary)]">Theaver</span>
        </a>
        <p class="mt-3 max-w-xs text-[13.5px] leading-relaxed text-[var(--text-secondary)]">
          {t.tagline}
        </p>
      </div>

      <div>
        <h2 class="text-[13px] font-medium text-[var(--text-primary)]">{t.product}</h2>
        <ul class="mt-3 flex flex-col gap-2 text-[13.5px] text-[var(--text-secondary)]">
          <li><a href={`${localizePath('/', locale)}#features`} class="hover:text-[var(--text-primary)]">{t.features}</a></li>
          <li><a href={localizePath('/downloads', locale)} class="hover:text-[var(--text-primary)]">{t.downloads}</a></li>
          <li><a href={WEB_APP_URL} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)]">{t.webClient}</a></li>
          <li><a href={localizePath('/changelog', locale)} class="hover:text-[var(--text-primary)]">{t.changelog}</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-[13px] font-medium text-[var(--text-primary)]">{t.developers}</h2>
        <ul class="mt-3 flex flex-col gap-2 text-[13.5px] text-[var(--text-secondary)]">
          <li><a href={localizePath('/docs/bots/overview-botmother', locale)} class="hover:text-[var(--text-primary)]">{t.botPlatform}</a></li>
          <li><a href={localizePath('/docs/bots/mini-apps-sdk', locale)} class="hover:text-[var(--text-primary)]">{t.miniApps}</a></li>
          <li><a href={localizePath('/docs/client/rest-api-reference', locale)} class="hover:text-[var(--text-primary)]">{t.restApi}</a></li>
          <li><a href={localizePath('/docs/client/websocket-rpc', locale)} class="hover:text-[var(--text-primary)]">{t.wsRpc}</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-[13px] font-medium text-[var(--text-primary)]">{t.resources}</h2>
        <ul class="mt-3 flex flex-col gap-2 text-[13.5px] text-[var(--text-secondary)]">
          <li><a href={localizePath('/docs/guide/getting-started', locale)} class="hover:text-[var(--text-primary)]">{t.userGuide}</a></li>
          <li><a href={localizePath('/docs/guide/verify-downloads', locale)} class="hover:text-[var(--text-primary)]">{t.verifyBuilds}</a></li>
          <li><a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)]">{t.sourceCode}</a></li>
          <li><a href={localizePath('/privacy', locale)} class="hover:text-[var(--text-primary)]">{t.privacy}</a></li>
          <li><a href={localizePath('/terms', locale)} class="hover:text-[var(--text-primary)]">{t.terms}</a></li>
          <li><a href={localizePath('/security', locale)} class="hover:text-[var(--text-primary)]">{t.security}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--border-hairline)] pt-6 text-[12.5px] text-[var(--text-muted)]">
      <span>&copy; {year} {t.copyright}</span>
      <span class="font-mono">theaver.app · app.theaver.app</span>
    </div>
  </div>
</footer>
