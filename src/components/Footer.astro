---
import BrandMark from './BrandMark.astro';
import { UI_STRINGS, localizePath, type Locale } from '../lib/i18n';
import { GITHUB_REPO_URL, WEB_APP_URL } from '../lib/releases';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI_STRINGS[locale].footer;
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border-hairline)] bg-[var(--bg-alt)] py-16">
  <div class="container-page">
    <div class="grid gap-10 md:grid-cols-5">
      <div class="md:col-span-2">
        <a href={localizePath('/', locale)} class="inline-flex items-center gap-2.5">
          <BrandMark size={26} />
          <span class="text-[15px] font-semibold text-[var(--text-primary)]">Theaver</span>
        </a>
        <p class="mt-3 max-w-xs text-[14px] leading-relaxed text-[var(--text-secondary)]">
          {t.tagline}
        </p>
      </div>

      <div>
        <h2 class="text-[12px] font-semibold text-[var(--text-primary)]">{t.product}</h2>
        <ul class="mt-2.5 flex flex-col text-[14px] leading-[2.1] text-[var(--text-secondary)]">
          <li><a href={`${localizePath('/', locale)}#features`} class="hover:text-[var(--accent)] hover:underline">{t.features}</a></li>
          <li><a href={localizePath('/downloads', locale)} class="hover:text-[var(--accent)] hover:underline">{t.downloads}</a></li>
          <li><a href={WEB_APP_URL} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--accent)] hover:underline">{t.webClient}</a></li>
          <li><a href={localizePath('/changelog', locale)} class="hover:text-[var(--accent)] hover:underline">{t.changelog}</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-[12px] font-semibold text-[var(--text-primary)]">{t.developers}</h2>
        <ul class="mt-2.5 flex flex-col text-[14px] leading-[2.1] text-[var(--text-secondary)]">
          <li><a href={localizePath('/docs', locale)} class="hover:text-[var(--accent)] hover:underline">{t.docsHub}</a></li>
          <li><a href={localizePath('/developers/apps', locale)} class="hover:text-[var(--accent)] hover:underline">{t.developerApps}</a></li>
          <li><a href={localizePath('/docs/bots/overview-botmother', locale)} class="hover:text-[var(--accent)] hover:underline">{t.botPlatform}</a></li>
          <li><a href={localizePath('/docs/bots/mini-apps-sdk', locale)} class="hover:text-[var(--accent)] hover:underline">{t.miniApps}</a></li>
          <li><a href={localizePath('/docs/client/rest-api-reference', locale)} class="hover:text-[var(--accent)] hover:underline">{t.restApi}</a></li>
          <li><a href={localizePath('/docs/client/websocket-rpc', locale)} class="hover:text-[var(--accent)] hover:underline">{t.wsRpc}</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-[12px] font-semibold text-[var(--text-primary)]">{t.resources}</h2>
        <ul class="mt-2.5 flex flex-col text-[14px] leading-[2.1] text-[var(--text-secondary)]">
          <li><a href={localizePath('/docs/guide/getting-started', locale)} class="hover:text-[var(--accent)] hover:underline">{t.userGuide}</a></li>
          <li><a href={localizePath('/docs/guide/verify-downloads', locale)} class="hover:text-[var(--accent)] hover:underline">{t.verifyBuilds}</a></li>
          <li><a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--accent)] hover:underline">{t.sourceCode}</a></li>
          <li><a href={localizePath('/privacy', locale)} class="hover:text-[var(--accent)] hover:underline">{t.privacy}</a></li>
          <li><a href={localizePath('/terms', locale)} class="hover:text-[var(--accent)] hover:underline">{t.terms}</a></li>
          <li><a href={localizePath('/security', locale)} class="hover:text-[var(--accent)] hover:underline">{t.security}</a></li>
          <li><a href={localizePath('/delete-account', locale)} class="hover:text-[var(--accent)] hover:underline">{t.deleteAccount}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--border-hairline)] pt-6 text-[12px] text-[var(--text-muted)]">
      <span>&copy; {year} {t.copyright}</span>
      <span class="font-mono">theaver.app · app.theaver.app</span>
    </div>
  </div>
</footer>
