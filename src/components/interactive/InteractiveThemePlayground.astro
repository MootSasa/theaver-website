---
import Icon from '../Icon.astro';
import ScreenshotFrame from '../ScreenshotFrame.astro';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const c = locale === 'ru'
  ? {
      curtainLabel: 'Прокрути страницу или потяни ползунок — День и Ночь меняются прямо на экране',
      dayTag: 'Дневная палитра',
      nightTag: 'Ночная палитра',
      scrubberLabel: 'Сравнение светлой и тёмной темы',
      tabsAria: 'Режим оформления интерфейса',
      tabGlass: 'Liquid Glass',
      tabClassic: 'Классика',
      glassDesc: 'Полупрозрачные панели и мягкое размытие глубины.',
      classicDesc: 'Чёткие матовые границы без прозрачности.',
      accentsTitle: 'Выбери акцент под настроение',
      sampleName: 'Дизайн-чат',
      sampleMsg1: 'Скинул новую тему с мягким стеклом, посмотри!',
      sampleMsg2: 'Ого, забираю себе по ссылке',
    }
  : {
      curtainLabel: 'Scroll or drag the slider to sweep Day across Night',
      dayTag: 'Light Look',
      nightTag: 'Dark Look',
      scrubberLabel: 'Compare Light and Dark theme split',
      tabsAria: 'Interface surface style',
      tabGlass: 'Liquid Glass',
      tabClassic: 'Classic',
      glassDesc: 'Translucent navigation bars that tint subtly with your wallpaper.',
      classicDesc: 'Crisp matte bars with zero translucency.',
      accentsTitle: 'Pick an accent that matches you',
      sampleName: 'Design Chat',
      sampleMsg1: 'Just dropped a new glass theme, check it out!',
      sampleMsg2: 'Clean! Grabbing it by link now',
    };

const swatches = [
  { id: 'ocean', color: '#00558f', darkAccent: '#4da6ff', soft: 'rgba(0, 85, 143, 0.14)', label: locale === 'ru' ? 'Океан' : 'Ocean' },
  { id: 'amber', color: '#8c3f0f', darkAccent: '#ffb37f', soft: 'rgba(255, 179, 127, 0.22)', label: locale === 'ru' ? 'Янтарь' : 'Amber' },
  { id: 'emerald', color: '#16a34a', darkAccent: '#4cc38a', soft: 'rgba(22, 163, 74, 0.14)', label: locale === 'ru' ? 'Мята' : 'Mint' },
  { id: 'crimson', color: '#dc2626', darkAccent: '#e5484d', soft: 'rgba(220, 38, 38, 0.14)', label: locale === 'ru' ? 'Коралл' : 'Coral' },
  { id: 'graphite', color: '#424245', darkAccent: '#a1a1a6', soft: 'rgba(110, 110, 115, 0.16)', label: locale === 'ru' ? 'Графит' : 'Graphite' },
];
---

<div class="theme-playground-root" data-theme-playground>
  <!-- Part A: Scroll-driven Day ↔ Night Curtain Scrollytelling + manual scrubber -->
  <div class="curtain-scrolly-box mx-auto max-w-5xl" data-curtain-box>
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2 text-[13px] text-[var(--text-secondary)]">
        <span class="inline-flex h-7 items-center rounded-full border border-[var(--border-hairline)] bg-[var(--bg-alt)] px-3 font-semibold">
          {c.dayTag} / {c.nightTag}
        </span>
        <span class="hidden sm:inline">{c.curtainLabel}</span>
      </div>

      <label class="flex items-center gap-3 text-[12.5px] text-[var(--text-muted)]">
        <Icon name="sun" size={14} />
        <input
          type="range"
          min="5"
          max="95"
          value="50"
          data-curtain-range
          aria-label={c.scrubberLabel}
          class="h-2 w-28 accent-[var(--accent)] sm:w-36"
        />
        <Icon name="moon" size={14} />
      </label>
    </div>

    <div
      class="curtain-stage relative overflow-hidden rounded-[var(--radius-frame)] border border-[var(--border-hairline)] bg-[var(--bg-deep)] shadow-[var(--frame-shadow)]"
      data-curtain-stage
    >
      <!-- Base layer: Dark Render -->
      <div class="block w-full">
        <ScreenshotFrame
          name="hero-desktop"
          locale={locale}
          forcedTheme="dark"
          framed={false}
          alt="Dark theme preview"
          width={1200}
          height={750}
        />
      </div>

      <!-- Top layer clipped on scroll/scrub: Light Render -->
      <div
        class="curtain-light-overlay pointer-events-none absolute inset-0"
        data-curtain-overlay
      >
        <ScreenshotFrame
          name="hero-desktop"
          locale={locale}
          forcedTheme="light"
          framed={false}
          alt="Light theme preview"
          width={1200}
          height={750}
        />
      </div>

      <span class="pointer-events-none absolute bottom-3 left-3 rounded-full border border-black/15 bg-white/90 px-2.5 py-1 text-[11px] font-semibold text-[#1d1d1f] backdrop-blur-md">
        {c.dayTag}
      </span>
      <span class="pointer-events-none absolute bottom-3 right-3 rounded-full border border-white/15 bg-black/80 px-2.5 py-1 text-[11px] font-semibold text-[#f5f5f7] backdrop-blur-md">
        {c.nightTag}
      </span>
    </div>
  </div>

  <!-- Part B: Liquid Glass / Classic Tabs (Anchor-positioned underline) + Accent Swatches -->
  <div class="mx-auto mt-12 grid max-w-5xl items-center gap-8 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div
          role="tablist"
          aria-label={c.tabsAria}
          class="playground-tablist relative inline-flex gap-1 border-b border-[var(--border-hairline)] pb-1"
        >
          <button
            type="button"
            role="tab"
            id="pg-tab-glass"
            aria-selected="true"
            data-pg-tab="glass"
            class="px-3.5 py-2 text-[14px] font-semibold text-[var(--accent)] transition-colors duration-150"
          >
            {c.tabGlass}
          </button>
          <button
            type="button"
            role="tab"
            id="pg-tab-classic"
            aria-selected="false"
            data-pg-tab="classic"
            class="px-3.5 py-2 text-[14px] font-semibold text-[var(--text-muted)] transition-colors duration-150 hover:text-[var(--text-primary)]"
          >
            {c.tabClassic}
          </button>
        </div>

        <p class="text-[13px] text-[var(--text-secondary)]" data-pg-mode-desc data-desc-glass={c.glassDesc} data-desc-classic={c.classicDesc}>
          {c.glassDesc}
        </p>
      </div>

      <!-- Initial state rendered in HTML: inactive panel has hidden -->
      <div role="tabpanel" aria-labelledby="pg-tab-glass" data-pg-panel="glass" tabindex="0">
        <ScreenshotFrame
          name="theme-glass"
          locale={locale}
          alt={c.tabGlass}
          width={880}
          height={550}
        />
      </div>

      <div role="tabpanel" aria-labelledby="pg-tab-classic" data-pg-panel="classic" hidden>
        <ScreenshotFrame
          name="theme-classic"
          locale={locale}
          alt={c.tabClassic}
          width={880}
          height={550}
        />
      </div>
    </div>

    <!-- Live Accent Swatch Tactile Card -->
    <div class="lg:col-span-5">
      <div
        class="ink-card p-6"
        data-swatch-preview
        style="--pg-accent: #00558f; --pg-soft: rgba(0, 85, 143, 0.14);"
      >
        <div class="text-[14px] font-semibold text-[var(--text-primary)]">
          {c.accentsTitle}
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-3" role="group" aria-label={c.accentsTitle}>
          {swatches.map((sw, idx) => (
            <button
              type="button"
              data-swatch-btn
              data-color={sw.color}
              data-dark={sw.darkAccent}
              data-soft={sw.soft}
              aria-label={sw.label}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              title={sw.label}
              class:list={[
                'h-9 w-9 rounded-full border-2 transition-transform duration-150 hover:scale-105',
                idx === 0 ? 'border-[var(--text-primary)] scale-105' : 'border-transparent',
              ]}
              style={`background-color: ${sw.color};`}
            />
          ))}
        </div>

        <div class="mt-6 flex flex-col gap-3 rounded-[var(--radius-card)] border border-[var(--border-hairline)] bg-[var(--bg-alt)] p-4">
          <div class="flex items-center justify-between border-b border-[var(--border-hairline)] pb-2.5 text-[13px]">
            <span class="font-semibold text-[var(--text-primary)]">{c.sampleName}</span>
            <span
              class="rounded-full px-2.5 py-0.5 text-[11.5px] font-semibold"
              style="background-color: var(--pg-soft); color: var(--pg-accent);"
            >
              Liquid Glass
            </span>
          </div>

          <div class="max-w-[85%] self-start rounded-[14px] rounded-bl-[4px] border border-[var(--border-hairline)] bg-[var(--bg-card)] px-3.5 py-2.5 text-[13.5px] text-[var(--text-primary)]">
            {c.sampleMsg1}
          </div>

          <div
            class="max-w-[80%] self-end rounded-[14px] rounded-br-[4px] px-3.5 py-2.5 text-[13.5px] text-white transition-colors duration-150"
            style="background-color: var(--pg-accent);"
          >
            {c.sampleMsg2}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .curtain-light-overlay {
    clip-path: inset(0 50% 0 0);
  }

  @keyframes theaver-curtain-wipe {
    from {
      clip-path: inset(0 82% 0 0);
    }
    to {
      clip-path: inset(0 18% 0 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .curtain-scrolly-box:not([data-manual="1"]) {
        view-timeline: --curtain-tl block;
        timeline-scope: --curtain-tl;
      }

      .curtain-scrolly-box:not([data-manual="1"]) .curtain-light-overlay {
        animation: theaver-curtain-wipe auto linear both;
        animation-timeline: --curtain-tl;
        animation-range: entry 20% cover 78%;
      }
    }
  }

  /* Anchor-positioned sliding underline on Liquid Glass / Classic segmented tabs */
  .playground-tablist [role="tab"][aria-selected="true"] {
    anchor-name: --active-pg-tab;
  }

  .playground-tablist::before {
    content: "";
    position: absolute;
    position-anchor: --active-pg-tab;
    inset-block-start: calc(anchor(self-end) - 1px);
    inset-inline-start: anchor(self-start);
    inset-inline-end: anchor(self-end);
    border-block-end: 2px solid var(--accent);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .playground-tablist::before {
      transition: inset 0.2s var(--ease-standard);
    }
  }

  @supports not (position-anchor: --active-pg-tab) {
    .playground-tablist::before {
      content: none;
    }

    .playground-tablist [role="tab"][aria-selected="true"] {
      border-block-end: 2px solid var(--accent);
    }
  }
</style>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-theme-playground]').forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      const curtainBox = root.querySelector('[data-curtain-box]');
      const curtainOverlay = root.querySelector('[data-curtain-overlay]');
      const curtainRange = root.querySelector('[data-curtain-range]');

      function setSplit(pct) {
        if (!(curtainOverlay instanceof HTMLElement)) return;
        const clamped = Math.min(95, Math.max(5, Number(pct) || 50));
        curtainOverlay.style.clipPath = `inset(0 ${100 - clamped}% 0 0)`;
      }

      if (curtainRange instanceof HTMLInputElement) {
        curtainRange.addEventListener('input', () => {
          if (curtainBox instanceof HTMLElement) {
            curtainBox.setAttribute('data-manual', '1');
          }
          setSplit(Number(curtainRange.value));
        });
      }

      // IntersectionObserver fallback when scroll-driven animations are unavailable
      if (
        curtainBox instanceof HTMLElement &&
        curtainOverlay instanceof HTMLElement &&
        !CSS.supports('(animation-timeline: view()) and (animation-range: entry)') &&
        window.matchMedia('(prefers-reduced-motion: no-preference)').matches
      ) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (curtainBox.getAttribute('data-manual') === '1') return;
            for (const entry of entries) {
              const ratio = Math.min(1, Math.max(0, entry.intersectionRatio));
              const pct = Math.round(18 + ratio * 64);
              setSplit(pct);
              if (curtainRange instanceof HTMLInputElement) {
                curtainRange.value = String(pct);
              }
            }
          },
          { threshold: Array.from({ length: 41 }, (_, i) => i / 40) },
        );
        observer.observe(curtainBox);
      }

      // Liquid Glass / Classic tabs
      const tabs = Array.from(root.querySelectorAll('[data-pg-tab]'));
      const panels = Array.from(root.querySelectorAll('[data-pg-panel]'));
      const modeDesc = root.querySelector('[data-pg-mode-desc]');

      function activateTab(key) {
        tabs.forEach((tab) => {
          const on = tab.getAttribute('data-pg-tab') === key;
          tab.setAttribute('aria-selected', on ? 'true' : 'false');
          tab.classList.toggle('text-[var(--accent)]', on);
          tab.classList.toggle('text-[var(--text-muted)]', !on);
        });
        panels.forEach((panel) => {
          if (!(panel instanceof HTMLElement)) return;
          const match = panel.getAttribute('data-pg-panel') === key;
          panel.hidden = !match;
          if (match) panel.setAttribute('tabindex', '0');
          else panel.removeAttribute('tabindex');
        });
        if (modeDesc instanceof HTMLElement) {
          modeDesc.textContent = modeDesc.getAttribute(`data-desc-${key}`) || '';
        }
      }

      tabs.forEach((tab, idx) => {
        tab.addEventListener('click', () => {
          const key = tab.getAttribute('data-pg-tab') || 'glass';
          activateTab(key);
        });
        tab.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            const next = tabs[(idx + 1) % tabs.length];
            if (next instanceof HTMLElement) {
              activateTab(next.getAttribute('data-pg-tab') || 'glass');
              next.focus();
            }
          }
        });
      });

      // Accent pigment swatches
      const preview = root.querySelector('[data-swatch-preview]');
      const swatchBtns = Array.from(root.querySelectorAll('[data-swatch-btn]'));
      swatchBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const color = btn.getAttribute('data-color') || '#00558f';
          const soft = btn.getAttribute('data-soft') || 'rgba(0, 85, 143, 0.14)';
          if (preview instanceof HTMLElement) {
            preview.style.setProperty('--pg-accent', color);
            preview.style.setProperty('--pg-soft', soft);
          }
          swatchBtns.forEach((b) => {
            const on = b === btn;
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
            b.classList.toggle('border-[var(--text-primary)]', on);
            b.classList.toggle('scale-105', on);
            b.classList.toggle('border-transparent', !on);
          });
        });
      });
    });
  })();
</script>
