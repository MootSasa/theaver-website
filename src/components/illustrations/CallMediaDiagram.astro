---
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = locale === 'ru'
  ? {
      title: 'Медиатракт звонков и стримов',
      peer: 'Клиенты (WebRTC)',
      peerSub: 'Opus · H.264 / VP8',
      turn: 'Coturn TLS 443',
      turnSub: 'Обход корпоративных NAT',
      sfu: 'LiveKit SFU',
      sfuSub: 'Аудио, 1080p60 экран и WHIP',
    }
  : {
      title: 'Voice, video, and stream pipeline',
      peer: 'Clients (WebRTC)',
      peerSub: 'Opus · H.264 / VP8',
      turn: 'Coturn TLS 443',
      turnSub: 'Firewall & NAT traversal',
      sfu: 'LiveKit SFU',
      sfuSub: 'Voice · 1080p60 · WHIP',
    };
---

<div class="ink-card p-5">
  <div class="mb-3 font-mono text-[12px] text-[var(--text-muted)]">{copy.title}</div>
  <svg viewBox="0 0 600 132" class="h-auto w-full" role="img" aria-label={copy.title}>
    <rect x="8" y="20" width="168" height="88" rx="10" fill="var(--bg-raised)" stroke="var(--border-strong)" />
    <text x="92" y="54" fill="var(--text-primary)" font-size="13" font-weight="600" text-anchor="middle" font-family="var(--font-sans)">{copy.peer}</text>
    <text x="92" y="76" fill="var(--text-muted)" font-size="11" text-anchor="middle" font-family="var(--font-mono)">{copy.peerSub}</text>

    <path d="M180 64h28" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="3 3" />

    <rect x="212" y="20" width="176" height="88" rx="10" fill="var(--bg-raised)" stroke="var(--border-strong)" />
    <text x="300" y="54" fill="var(--text-primary)" font-size="13" font-weight="600" text-anchor="middle" font-family="var(--font-sans)">{copy.turn}</text>
    <text x="300" y="76" fill="var(--text-muted)" font-size="11" text-anchor="middle" font-family="var(--font-mono)">{copy.turnSub}</text>

    <path d="M392 64h28" stroke="var(--accent)" stroke-width="1.5" />

    <rect x="424" y="20" width="168" height="88" rx="10" fill="var(--bg-raised)" stroke="var(--accent)" />
    <text x="508" y="54" fill="var(--text-primary)" font-size="13" font-weight="600" text-anchor="middle" font-family="var(--font-sans)">{copy.sfu}</text>
    <text x="508" y="76" fill="var(--accent)" font-size="10.5" text-anchor="middle" font-family="var(--font-mono)">{copy.sfuSub}</text>
  </svg>
</div>
