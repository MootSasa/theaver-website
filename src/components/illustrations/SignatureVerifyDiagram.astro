---
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = locale === 'ru'
  ? {
      title: 'Криптографическая проверка релизов',
      ci: 'Публичный репозиторий и CI',
      ciSub: 'MootSasa/theaver-frontend',
      sign: 'Подписи и хэши',
      signSub: 'SHA-256 · GPG (.asc) · Windows CA',
      client: 'Проверенная установка',
      clientSub: 'Сверка до запуска',
    }
  : {
      title: 'Cryptographic Release Verification',
      ci: 'Public Source & CI',
      ciSub: 'MootSasa/theaver-frontend',
      sign: 'Checksums & Keys',
      signSub: 'SHA-256 · GPG (.asc) · Windows CA',
      client: 'Verified Install',
      clientSub: 'Checked before launch',
    };
---

<div class="ink-card p-5">
  <div class="mb-3 font-mono text-[12px] text-[var(--text-muted)]">{copy.title}</div>
  <svg viewBox="0 0 600 132" class="h-auto w-full" role="img" aria-label={copy.title}>
    <rect x="8" y="20" width="176" height="88" rx="10" fill="var(--bg-raised)" stroke="var(--border-strong)" />
    <text x="96" y="54" fill="var(--text-primary)" font-size="13" font-weight="500" text-anchor="middle" font-family="var(--font-sans)">{copy.ci}</text>
    <text x="96" y="76" fill="var(--text-muted)" font-size="10.5" text-anchor="middle" font-family="var(--font-mono)">{copy.ciSub}</text>

    <path d="M188 64h24m-5-4l5 4-5 4" stroke="var(--accent)" stroke-width="1.5" fill="none" stroke-linecap="round" />

    <rect x="216" y="20" width="184" height="88" rx="10" fill="var(--bg-raised)" stroke="var(--accent)" />
    <text x="308" y="54" fill="var(--text-primary)" font-size="13" font-weight="500" text-anchor="middle" font-family="var(--font-sans)">{copy.sign}</text>
    <text x="308" y="76" fill="var(--accent)" font-size="10.5" text-anchor="middle" font-family="var(--font-mono)">{copy.signSub}</text>

    <path d="M404 64h24m-5-4l5 4-5 4" stroke="var(--positive)" stroke-width="1.5" fill="none" stroke-linecap="round" />

    <rect x="432" y="20" width="160" height="88" rx="10" fill="var(--bg-raised)" stroke="var(--positive)" />
    <text x="512" y="54" fill="var(--text-primary)" font-size="13" font-weight="500" text-anchor="middle" font-family="var(--font-sans)">{copy.client}</text>
    <text x="512" y="76" fill="var(--positive)" font-size="11" text-anchor="middle" font-family="var(--font-mono)">{copy.clientSub}</text>
  </svg>
</div>
