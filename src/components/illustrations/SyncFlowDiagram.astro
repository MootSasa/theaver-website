---
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = locale === 'ru'
  ? {
      title: 'Очередь сообщений и дельта-синхронизация',
      client: 'Клиент (Drift SQLite)',
      clientSub: 'Сохраняет local_id локально',
      ws: 'WebSocket RPC',
      wsSub: 'send_message · ack req_id',
      server: 'Сервер и БД',
      serverSub: 'UNIQUE (chat, sender, local_id)',
      devices: 'Другие устройства',
      devicesSub: 'since_usn delta + High-Water Mark',
    }
  : {
      title: 'Outbox queue and delta sync',
      client: 'Client (Drift SQLite)',
      clientSub: 'Stores local_id locally',
      ws: 'WebSocket RPC',
      wsSub: 'send_message · ack req_id',
      server: 'Backend & PostgreSQL',
      serverSub: 'UNIQUE (chat, sender, local_id)',
      devices: 'Other devices',
      devicesSub: 'since_usn delta + High-Water Mark',
    };
---

<div class="ink-card p-5">
  <div class="mb-3 font-mono text-[12px] text-[var(--text-muted)]">{copy.title}</div>
  <svg viewBox="0 0 760 176" class="h-auto w-full" role="img" aria-label={copy.title}>
    <rect x="8" y="20" width="212" height="84" rx="10" fill="var(--bg-raised)" stroke="var(--border-strong)" />
    <text x="114" y="54" fill="var(--text-primary)" font-size="13" font-weight="600" text-anchor="middle" font-family="var(--font-sans)">{copy.client}</text>
    <text x="114" y="76" fill="var(--text-muted)" font-size="10.5" text-anchor="middle" font-family="var(--font-mono)">{copy.clientSub}</text>

    <path d="M224 62h32m-6-5l6 5-6 5" stroke="var(--accent)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />

    <rect x="260" y="20" width="208" height="84" rx="10" fill="var(--bg-raised)" stroke="var(--accent)" />
    <text x="364" y="54" fill="var(--text-primary)" font-size="13" font-weight="600" text-anchor="middle" font-family="var(--font-sans)">{copy.ws}</text>
    <text x="364" y="76" fill="var(--accent)" font-size="10.5" text-anchor="middle" font-family="var(--font-mono)">{copy.wsSub}</text>

    <path d="M472 62h32m-6-5l6 5-6 5" stroke="var(--accent)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />

    <rect x="508" y="20" width="244" height="84" rx="10" fill="var(--bg-raised)" stroke="var(--border-strong)" />
    <text x="630" y="54" fill="var(--text-primary)" font-size="13" font-weight="600" text-anchor="middle" font-family="var(--font-sans)">{copy.server}</text>
    <text x="630" y="76" fill="var(--text-muted)" font-size="10.5" text-anchor="middle" font-family="var(--font-mono)">{copy.serverSub}</text>

    <path d="M630 108v32H114v-32" stroke="var(--border-strong)" stroke-width="1.4" stroke-dasharray="4 4" fill="none" />
    <rect x="170" y="122" width="420" height="36" rx="8" fill="var(--bg-card)" stroke="var(--border-hairline)" />
    <text x="380" y="144" fill="var(--text-secondary)" font-size="11" text-anchor="middle" font-family="var(--font-mono)">{copy.devices} · {copy.devicesSub}</text>
  </svg>
</div>
