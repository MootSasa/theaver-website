---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Icon from '../Icon.astro';
import type { Locale } from '../../lib/i18n';
import {
  fetchPublicReleases,
  GITHUB_RELEASES_URL,
  parseChannelReleaseEntry,
  type ChangelogEntryData,
} from '../../lib/releases';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const curatedEntries: ChangelogEntryData[] = locale === 'ru'
  ? [
      {
        version: 'v1.20.3-beta.429',
        date: '2026-11-09',
        channel: 'beta',
        title: 'Плавные переходы, превью ссылок и стабильность стикеров',
        sections: [
          {
            kind: 'fixed',
            items: [
              'Кастомные эмодзи и внутренние ссылки хранилища больше не рисуют лишнюю карточку превью веб-страницы в пузыре сообщения.',
              'Анимации стикеров и GIF перестали подёргиваться при быстром пролистывании ленты чата.',
            ],
          },
          {
            kind: 'improved',
            items: [
              'Переход между списком чатов, диалогом и профилем стал плавнее и без пропусков кадров.',
            ],
          },
        ],
      },
      {
        version: 'v1.20.0-beta.423',
        date: '2026-11-09',
        channel: 'beta',
        title: 'Mini Apps v8, проверки кошелька Walt и подпись сборок',
        sections: [
          {
            kind: 'added',
            items: [
              'Обновили Mini Apps до версии v8.0 с кэшированием ETag, безопасными отступами экрана и быстрым запуском.',
              'Включили автоматическую подпись установщиков для Windows и GPG-подписи для архивов Linux.',
            ],
          },
          {
            kind: 'improved',
            items: [
              'Добавили дополнительные проверки для запросов Bot API и переводов в кошельке Walt (THV).',
            ],
          },
        ],
      },
      {
        version: 'v1.19.0-beta.421',
        date: '2026-11-08',
        channel: 'beta',
        title: 'Панель стикеров, сетка GIF и импорт из Telegram',
        sections: [
          {
            kind: 'added',
            items: [
              'Добавили отдельную боковую панель эмодзи и стикеров для многооконного режима на компьютере.',
              'Сделали адаптивную сетку GIF с предпросмотром по удержанию и отправкой в полном качестве.',
              'Появился импорт наборов стикеров из Telegram с отображением прогресса прямо в клиенте.',
            ],
          },
          {
            kind: 'improved',
            items: [
              'Стикеры и GIF за пределами экрана теперь ставятся на паузу, чтобы не нагружать процессор и батарею.',
            ],
          },
        ],
      },
      {
        version: 'v1.18.0-beta.400',
        date: '2026-11-07',
        channel: 'beta',
        title: 'Групповые звонки, стримы и сообщества',
        sections: [
          {
            kind: 'added',
            items: [
              'Запустили аудио- и видеозвонки, показ экрана и голосовые комнаты в сообществах.',
              'В истории чата появились карточки итогов звонков и раздельные настройки уведомлений.',
            ],
          },
        ],
      },
    ]
  : [
      {
        version: 'v1.20.3-beta.429',
        date: '2026-11-09',
        channel: 'beta',
        title: 'Smoother screen transitions, link previews, and steady stickers',
        sections: [
          {
            kind: 'fixed',
            items: [
              'Custom emoji and internal storage media links no longer trigger blank web link preview cards inside message bubbles.',
              'Animated stickers and GIFs no longer stutter when scrolling fast through long chats.',
            ],
          },
          {
            kind: 'improved',
            items: [
              'Opening chats and profile panels feels smoother without dropped frames.',
            ],
          },
        ],
      },
      {
        version: 'v1.20.0-beta.423',
        date: '2026-11-09',
        channel: 'beta',
        title: 'Mini Apps v8, Walt wallet checks, and signed installers',
        sections: [
          {
            kind: 'added',
            items: [
              'Upgraded Mini Apps to v8.0 with ETag caching, safe HUD insets, and faster launch events.',
              'Added automated Authenticode signing for Windows installers and GPG signatures for Linux archives.',
            ],
          },
          {
            kind: 'improved',
            items: [
              'Tightened validation checks across Bot API calls and Walt (THV) ledger transfers.',
            ],
          },
        ],
      },
      {
        version: 'v1.19.0-beta.421',
        date: '2026-11-08',
        channel: 'beta',
        title: 'Sticker sidecar, GIF grid, and Telegram pack import',
        sections: [
          {
            kind: 'added',
            items: [
              'Added a dedicated Emoji & Sticker side panel for wide desktop windows.',
              'Built a justified GIF grid with press-and-hold preview and full-resolution sending.',
              'Added direct Telegram sticker pack import with live progress inside the app.',
            ],
          },
          {
            kind: 'improved',
            items: [
              'Off-screen animated stickers and GIFs now pause automatically, keeping high refresh rates smooth during touch scrolling.',
            ],
          },
        ],
      },
      {
        version: 'v1.18.0-beta.400',
        date: '2026-11-07',
        channel: 'beta',
        title: 'Calls, screen sharing, and communities',
        sections: [
          {
            kind: 'added',
            items: [
              'Added voice calls, 1080p60 screen sharing, and voice channels inside communities.',
              'Added call summary cards in chat history along with per-chat notification settings.',
            ],
          },
        ],
      },
    ];

const labels = locale === 'ru'
  ? {
      title: 'История обновлений',
      description: 'Что менялось в новых версиях клиента и платформы Theaver на каналах Stable и Beta.',
      all: 'Все',
      stable: 'Stable',
      beta: 'Beta',
      added: 'Новое',
      improved: 'Улучшения',
      fixed: 'Исправления',
      tagLink: 'Открыть релиз на GitHub',
    }
  : {
      title: 'Changelog',
      description: 'What changed in recent Stable and Beta builds of Theaver.',
      all: 'All',
      stable: 'Stable',
      beta: 'Beta',
      added: 'Added',
      improved: 'Improved',
      fixed: 'Fixed',
      tagLink: 'View release on GitHub',
    };

const livePayload = await fetchPublicReleases();
const curatedVersions = new Set(curatedEntries.map((e) => e.version.toLowerCase()));
const dynamicEntries: ChangelogEntryData[] = [];

for (const chKey of ['stable', 'beta'] as const) {
  const chObj = livePayload.channels[chKey];
  if (!chObj) continue;
  const parsed = parseChannelReleaseEntry(chObj, locale);
  if (parsed && !curatedVersions.has(parsed.version.toLowerCase())) {
    dynamicEntries.push(parsed);
    curatedVersions.add(parsed.version.toLowerCase());
  }
}
dynamicEntries.sort((a, b) => b.date.localeCompare(a.date));
const entries: ChangelogEntryData[] = [...dynamicEntries, ...curatedEntries];
---

<MarketingLayout title={`${labels.title} — Theaver`} description={labels.description}>
  <section class="py-12 sm:py-16">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <div class="flex flex-wrap items-end justify-between gap-4 border-b border-[var(--border-hairline)] pb-6">
          <div>
            <h1 class="text-[32px] font-semibold leading-[1.15] text-[var(--text-primary)] sm:text-[38px]">
              {labels.title}
            </h1>
            <p class="mt-2 text-[15.5px] text-[var(--text-secondary)]">
              {labels.description}
            </p>
          </div>

          <div class="inline-flex rounded-[var(--radius-control)] border border-[var(--border-hairline)] bg-[var(--bg-deep)] p-1">
            {(['all', 'stable', 'beta'] as const).map((filter, idx) => (
              <button
                type="button"
                data-cl-filter={filter}
                class:list={[
                  'rounded-[var(--radius-chip)] px-3 py-1 text-[13px] font-medium transition-colors duration-150',
                  idx === 0
                    ? 'bg-[var(--bg-card)] text-[var(--text-primary)] shadow-[var(--card-highlight)]'
                    : 'text-[var(--text-muted)] hover:text-[var(--text-primary)]',
                ]}
              >
                {labels[filter]}
              </button>
            ))}
          </div>
        </div>

        <div class="mt-8 flex flex-col gap-6" id="changelog-list">
          {entries.map((entry) => (
            <article class="ink-card p-6" data-cl-channel={entry.channel}>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-3">
                  <span class="tabular font-mono text-[14px] font-medium text-[var(--accent)]">
                    {entry.version}
                  </span>
                  <span class="rounded-[var(--radius-chip)] border border-[var(--border-hairline)] bg-[var(--bg-raised)] px-2 py-0.5 text-[12px] text-[var(--text-secondary)]">
                    {entry.channel === 'beta' ? labels.beta : labels.stable}
                  </span>
                </div>
                <time class="tabular font-mono text-[12.5px] text-[var(--text-muted)]">
                  {entry.date}
                </time>
              </div>

              <h2 class="mt-3 text-[20px] font-semibold text-[var(--text-primary)]">
                {entry.title}
              </h2>

              <div class="mt-4 flex flex-col gap-4">
                {entry.sections.map((sec) => (
                  <div>
                    <div class="text-[12.5px] font-medium text-[var(--text-muted)]">
                      {labels[sec.kind]}
                    </div>
                    <ul class="mt-1.5 flex flex-col gap-1.5 text-[14.5px] leading-relaxed text-[var(--text-secondary)]">
                      {sec.items.map((item) => (
                        <li class="flex items-start gap-2">
                          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--accent)]" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              <div class="mt-5 border-t border-[var(--border-hairline)] pt-4">
                <a
                  href={`${GITHUB_RELEASES_URL}/tag/${entry.version}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-[13px] text-[var(--text-secondary)] hover:text-[var(--accent)]"
                >
                  <Icon name="github" size={14} />
                  <span>{labels.tagLink}</span>
                  <Icon name="arrow-up-right" size={13} />
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>

<script is:inline>
  (() => {
    const buttons = document.querySelectorAll('[data-cl-filter]');
    const cards = document.querySelectorAll('[data-cl-channel]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-cl-filter') || 'all';
        buttons.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('bg-[var(--bg-card)]', on);
          b.classList.toggle('text-[var(--text-primary)]', on);
          b.classList.toggle('shadow-[var(--card-highlight)]', on);
          b.classList.toggle('text-[var(--text-muted)]', !on);
        });
        cards.forEach((card) => {
          const ch = card.getAttribute('data-cl-channel');
          card.classList.toggle('hidden', target !== 'all' && ch !== target);
        });
      });
    });
  })();
</script>
