---
import { Code } from 'astro:components';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Icon from '../Icon.astro';
import ScreenshotFrame from '../ScreenshotFrame.astro';
import SmartDownloadButton from '../SmartDownloadButton.astro';
import CodeTabs from '../docs/CodeTabs.astro';
import SyncFlowDiagram from '../illustrations/SyncFlowDiagram.astro';
import CallMediaDiagram from '../illustrations/CallMediaDiagram.astro';
import BotPlatformDiagram from '../illustrations/BotPlatformDiagram.astro';
import SignatureVerifyDiagram from '../illustrations/SignatureVerifyDiagram.astro';
import { localizePath, type Locale } from '../../lib/i18n';
import { fetchPublicReleases, GITHUB_REPO_URL, WEB_APP_URL } from '../../lib/releases';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const initialReleases = await fetchPublicReleases();
const rawHeroVer =
  initialReleases.channels.stable?.latest_version ||
  initialReleases.channels.beta?.latest_version ||
  '1.20';
const heroVersionTag = rawHeroVer.startsWith('v') ? rawHeroVer : `v${rawHeroVer}`;
const channelPill = locale === 'ru' ? `Релиз ${heroVersionTag}` : `Release ${heroVersionTag}`;

const aiogramSample = `from aiogram import Bot
from aiogram.client.session.aiohttp import AiohttpSession
from aiogram.client.telegram import TelegramAPIServer

session = AiohttpSession(
    api=TelegramAPIServer.from_base("https://api.theaver.app")
)
bot = Bot(token=BOT_TOKEN, session=session)`;

const grammySample = `import { Bot } from "grammy";

const bot = new Bot(process.env.BOT_TOKEN!, {
  client: {
    apiRoot: "https://api.theaver.app",
  },
});`;

const c = locale === 'ru'
  ? {
      metaTitle: 'Theaver — Быстрый мессенджер с открытым клиентом',
      metaDesc: 'Кроссплатформенный мессенджер с офлайн-синхронизацией, тайлинговым десктопом, звонками LiveKit и Telegram-совместимым Bot API.',
      heroTitle: 'Мессенджер, который держит ритм работы',
      heroSub: 'Личные чаты, каналы, звонки с демонстрацией экрана, мультиоконный ПК-тайлинг и платформа ботов на базе открытого клиента.',
      openBrowser: 'Открыть в браузере',
      heroAlt: 'Интерфейс десктопного клиента Theaver с тайлинговой панелью',
      section1Label: 'Синхронизация и каналы',
      section1Title: 'Работает мгновенно, даже без сети',
      section1Body: 'Сообщения, черновики и медиа кэшируются локально в Drift/SQLite. После восстановления связи очередь уходит через WebSocket RPC с идемпотентным ключом local_id — без дублей и пропусков.',
      section1List: [
        'Публичные каналы с комментариями, счётчиком просмотров и пересылкой',
        'Группы с темами форума, опросами, правами ролей и историей действий',
        'Единый прогресс прочтения High-Water Mark на всех устройствах',
      ],
      chatsAlt: 'Экран чата и офлайн-синхронизации на смартфоне Theaver',
      section2Label: 'Звонки и стримы',
      section2Title: 'Голос, видеокружки и экран в 1080p60',
      section2Body: 'Звонки один на один и групповые комнаты работают через LiveKit SFU и Coturn на порту TLS 443, проходя корпоративные сети без ручной настройки.',
      section2List: [
        'Захват окна или всего экрана до 60 fps',
        'Голосовые Opus и видеокружки с общей позицией',
        'Стримы RTMP и WHIP для OBS Studio',
      ],
      callsAlt: 'Окно группового звонка и демонстрации экрана в Theaver',
      section3Label: 'Десктоп и медиа',
      section3Title: 'Создан для большого экрана и клавиатуры',
      desktopCards: [
        {
          icon: 'layers' as const,
          title: 'Тайлинговый мультиоконный режим',
          body: 'Открывайте чат, ветку комментариев, боковую панель стикеров или Mini App рядом на одном экране без лишних переключений.',
        },
        {
          icon: 'message' as const,
          title: 'Стикеры, GIF и кастомные эмодзи',
          body: 'Живые паки стикеров, поиск по смыслу и импорт наборов из Telegram напрямую через клиент.',
        },
        {
          icon: 'laptop' as const,
          title: 'Темы оформления и Liquid Glass',
          body: 'Адаптивная светлая и тёмная тема, настройка акцентов и обмен пользовательскими темами по короткой ссылке.',
        },
      ],
      section4Badge: '@BotMother · Bot API & Mini Apps v8',
      section4Title: 'Перенесите Telegram-бота за одну строку',
      section4Body: 'Создайте бота у @BotMother и укажите базовый URL api.theaver.app в aiogram, grammY или python-telegram-bot. Доступны Long Polling, Webhooks, inline-режим, Mini Apps v8 и переводы в THV.',
      readBotDocs: 'Документация Bot API',
      section5Label: 'Прозрачность и проверки',
      section5Title: 'Открытый клиент и проверяемые релизы',
      section5Body: 'Исходный код Flutter-клиента полностью открыт. Каждая сборка снабжается контрольной суммой SHA-256, GPG-подписью для Linux и корневым сертификатом для Windows.',
      viewSource: 'Исходники на GitHub',
      verifyGuide: 'Как проверить подпись',
      ctaTitle: 'Установите Theaver на все устройства',
      ctaSub: 'Доступно для Windows, macOS, Linux, Android, iOS и в браузере без установки.',
      allPlatformsBtn: 'Перейти к загрузкам',
    }
  : {
      metaTitle: 'Theaver — Fast cross-platform messenger with an open client',
      metaDesc: 'Cross-platform messenger with offline-first SQLite sync, desktop tiling, LiveKit voice & screen share, and Telegram-compatible Bot API.',
      heroTitle: 'A fast messenger built for real work',
      heroSub: 'Direct chats, channels, screen-sharing calls, tiled desktop workspaces, and a compatible Bot & Mini Apps platform powered by an open-source client.',
      openBrowser: 'Open in Browser',
      heroAlt: 'Theaver Desktop workspace with tiled chat list, thread, and sidecar panel',
      section1Label: 'Sync & Channels',
      section1Title: 'Instant locally, resilient offline',
      section1Body: 'Messages, drafts, and media live in local Drift/SQLite storage. Reconnecting drains the outbox over WebSocket RPC using idempotent local_id keys so nothing drops or duplicates.',
      section1List: [
        'Public channels with comment threads, view counters, and scheduled posts',
        'Groups with forum topics, polls, granular admin permissions, and audit logs',
        'Atomic High-Water Mark read state synchronized across every logged-in device',
      ],
      chatsAlt: 'Theaver mobile chat and offline-first sync screen',
      section2Label: 'Voice & Streams',
      section2Title: 'Clear calls and 1080p60 screen sharing',
      section2Body: 'Direct calls and multi-participant voice rooms route through LiveKit SFU with Coturn over TLS port 443 to traverse strict firewalls reliably.',
      section2List: [
        'Low-latency window and display sharing up to 60 fps',
        'Opus voice notes and round video messages synced across devices',
        'RTMP and WHIP stream ingress for OBS Studio in communities',
      ],
      callsAlt: 'Theaver LiveKit group call and screen sharing window',
      section3Label: 'Desktop & Media',
      section3Title: 'Designed for wide screens, not stretched phone UI',
      desktopCards: [
        {
          icon: 'layers' as const,
          title: 'Tiled multi-window layout',
          body: 'Pin a conversation, discussion thread, sticker sidecar, or Mini App side by side inside one responsive workspace.',
        },
        {
          icon: 'message' as const,
          title: 'Stickers, GIFs & custom emoji',
          body: 'Smooth animated sticker rendering, semantic sticker search, and direct Telegram sticker pack import.',
        },
        {
          icon: 'laptop' as const,
          title: 'Custom themes & Liquid Glass',
          body: 'Tinted light and dark surfaces, custom bubble styles, and shareable theme links across devices.',
        },
      ],
      section4Badge: '@BotMother · Bot API & Mini Apps v8',
      section4Title: 'Migrate your Telegram bot in one line',
      section4Body: 'Register a bot via @BotMother and point aiogram, grammY, or python-telegram-bot at api.theaver.app. Supports Long Polling, Webhooks, inline queries, Mini Apps v8, and THV wallet payments.',
      readBotDocs: 'Read Bot API Docs',
      section5Label: 'Verifiable Builds',
      section5Title: 'Open-source client and signed installers',
      section5Body: 'The Flutter client source code is public on GitHub. Every build ships with SHA-256 checksums, detached GPG signatures on Linux, and signed installers on Windows.',
      viewSource: 'View Client Source',
      verifyGuide: 'Verification Guide',
      ctaTitle: 'Get Theaver on every screen',
      ctaSub: 'Native builds for Windows, macOS, Linux, Android, iOS, plus the Web client.',
      allPlatformsBtn: 'Browse all downloads',
    };
---

<MarketingLayout title={c.metaTitle} description={c.metaDesc}>
  <!-- Tile 1: Centered Gallery Hero (Canvas) -->
  <section class="bg-[var(--bg-page)] pt-14 pb-16 lg:pt-20 lg:pb-24">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <span class="badge-warm tabular">{channelPill}</span>
        <h1 class="mt-4 text-[36px] font-semibold leading-[1.07] tracking-[-0.022em] text-[var(--text-primary)] sm:text-[48px] lg:text-[56px]">
          {c.heroTitle}
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-[17px] font-normal leading-[1.47] text-[var(--text-secondary)] sm:text-[21px] sm:leading-[1.35]">
          {c.heroSub}
        </p>

        <div class="mt-8">
          <SmartDownloadButton locale={locale} initialReleases={initialReleases} align="center">
            <a
              slot="secondary"
              href={WEB_APP_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary"
            >
              <span>{c.openBrowser}</span>
              <Icon name="arrow-up-right" size={16} />
            </a>
          </SmartDownloadButton>
        </div>
      </div>

      <div class="mx-auto mt-12 max-w-[980px] lg:mt-16">
        <ScreenshotFrame
          name="hero-desktop"
          alt={c.heroAlt}
          width={960}
          height={600}
          priority={true}
        />
      </div>
    </div>
  </section>

  <!-- Tile 2: Sync & Channels (Parchment) -->
  <section id="features" class="bg-[var(--bg-alt)] py-14 lg:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-mono text-[12.5px] font-semibold tracking-tight text-[var(--accent)]">
          {c.section1Label}
        </p>
        <h2 class="mt-2 text-[30px] font-semibold leading-[1.1] tracking-[-0.02em] text-[var(--text-primary)] sm:text-[40px]">
          {c.section1Title}
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-[17px] leading-[1.47] text-[var(--text-secondary)]">
          {c.section1Body}
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl items-center gap-12 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-5">
          <div class="mx-auto max-w-[320px]">
            <ScreenshotFrame
              name="chats-mobile"
              alt={c.chatsAlt}
              width={380}
              height={640}
            />
          </div>
        </div>

        <div class="min-w-0 lg:col-span-7">
          <ul class="flex flex-col gap-3.5 text-[16px] leading-[1.47] text-[var(--text-secondary)]">
            {c.section1List.map((item) => (
              <li class="flex items-start gap-2.5">
                <Icon name="check" size={18} class="mt-1 shrink-0 text-[var(--positive)]" />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="mt-8">
            <SyncFlowDiagram locale={locale} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tile 3: Voice, Video & Streams (Canvas) -->
  <section class="bg-[var(--bg-page)] py-14 lg:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-mono text-[12.5px] font-semibold tracking-tight text-[var(--accent)]">
          {c.section2Label}
        </p>
        <h2 class="mt-2 text-[30px] font-semibold leading-[1.1] tracking-[-0.02em] text-[var(--text-primary)] sm:text-[40px]">
          {c.section2Title}
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-[17px] leading-[1.47] text-[var(--text-secondary)]">
          {c.section2Body}
        </p>
      </div>

      <div class="mx-auto mt-12 max-w-[820px]">
        <ScreenshotFrame
          name="calls-stream"
          alt={c.callsAlt}
          width={720}
          height={460}
        />
      </div>

      <div class="mx-auto mt-10 max-w-4xl">
        <div class="grid gap-4 text-[15px] leading-[1.47] text-[var(--text-secondary)] sm:grid-cols-3">
          {c.section2List.map((item) => (
            <div class="ink-card flex items-start gap-2.5 p-4">
              <Icon name="phone" size={17} class="mt-0.5 shrink-0 text-[var(--accent)]" />
              <span>{item}</span>
            </div>
          ))}
        </div>

        <div class="mt-8">
          <CallMediaDiagram locale={locale} />
        </div>
      </div>
    </div>
  </section>

  <!-- Tile 4: Desktop & Media Utility Grid (Parchment) -->
  <section class="bg-[var(--bg-alt)] py-14 lg:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-mono text-[12.5px] font-semibold tracking-tight text-[var(--accent)]">
          {c.section3Label}
        </p>
        <h2 class="mt-2 text-[30px] font-semibold leading-[1.1] tracking-[-0.02em] text-[var(--text-primary)] sm:text-[40px]">
          {c.section3Title}
        </h2>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-3">
        {c.desktopCards.map((card) => (
          <div class="ink-card flex flex-col justify-between p-7">
            <div>
              <div class="inline-flex h-10 w-10 items-center justify-center rounded-[var(--radius-control)] border border-[var(--border-hairline)] bg-[var(--bg-raised)] text-[var(--accent)]">
                <Icon name={card.icon} size={19} />
              </div>
              <h3 class="mt-5 text-[19px] font-semibold leading-[1.24] text-[var(--text-primary)]">
                {card.title}
              </h3>
              <p class="mt-2.5 text-[15px] leading-[1.5] text-[var(--text-secondary)]">
                {card.body}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tile 5: Featured Dark Contrast Spotlight — Bots, Mini Apps & Walt -->
  <section class="tile-contrast-dark py-14 lg:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <span class="badge-warm">{c.section4Badge}</span>
        <h2 class="mt-4 text-[30px] font-semibold leading-[1.1] tracking-[-0.02em] text-[var(--text-primary)] sm:text-[40px]">
          {c.section4Title}
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-[17px] leading-[1.47] text-[var(--text-secondary)]">
          {c.section4Body}
        </p>
        <div class="mt-7 flex justify-center">
          <a
            href={localizePath('/docs/bots/overview-botmother', locale)}
            class="btn-primary"
          >
            <Icon name="code" size={17} />
            <span>{c.readBotDocs}</span>
          </a>
        </div>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl items-start gap-8 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-5">
          <BotPlatformDiagram locale={locale} />
        </div>

        <div class="min-w-0 lg:col-span-7">
          <CodeTabs tabs={['Python (aiogram 3)', 'TypeScript (grammY)']}>
            <div class="min-w-0 max-w-full overflow-x-auto">
              <Code code={aiogramSample} lang="python" themes={{ light: 'github-light-default', dark: 'github-dark-default' }} />
            </div>
            <div class="hidden min-w-0 max-w-full overflow-x-auto">
              <Code code={grammySample} lang="ts" themes={{ light: 'github-light-default', dark: 'github-dark-default' }} />
            </div>
          </CodeTabs>
        </div>
      </div>
    </div>
  </section>

  <!-- Tile 6: Verifiable Open Client & Final Downloads CTA (Canvas) -->
  <section class="bg-[var(--bg-page)] py-14 lg:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-mono text-[12.5px] font-semibold tracking-tight text-[var(--accent)]">
          {c.section5Label}
        </p>
        <h2 class="mt-2 text-[30px] font-semibold leading-[1.1] tracking-[-0.02em] text-[var(--text-primary)] sm:text-[40px]">
          {c.section5Title}
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-[17px] leading-[1.47] text-[var(--text-secondary)]">
          {c.section5Body}
        </p>

        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            <Icon name="github" size={17} />
            <span>{c.viewSource}</span>
          </a>
          <a href={localizePath('/docs/guide/verify-downloads', locale)} class="btn-secondary">
            <Icon name="shield" size={17} />
            <span>{c.verifyGuide}</span>
          </a>
        </div>
      </div>

      <div class="mx-auto mt-10 max-w-3xl">
        <SignatureVerifyDiagram locale={locale} />
      </div>

      <div class="mx-auto mt-16 max-w-2xl text-center">
        <h2 class="text-[28px] font-semibold leading-[1.15] tracking-[-0.02em] text-[var(--text-primary)] sm:text-[34px]">
          {c.ctaTitle}
        </h2>
        <p class="mt-3 text-[17px] leading-[1.47] text-[var(--text-secondary)]">
          {c.ctaSub}
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href={localizePath('/downloads', locale)} class="btn-primary">
            <Icon name="download" size={17} />
            <span>{c.allPlatformsBtn}</span>
          </a>
          <a href={WEB_APP_URL} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            <span>{c.openBrowser}</span>
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
