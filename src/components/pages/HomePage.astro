---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Icon from '../Icon.astro';
import ScreenshotFrame from '../ScreenshotFrame.astro';
import SmartDownloadButton from '../SmartDownloadButton.astro';
import { localizePath, type Locale } from '../../lib/i18n';
import { fetchPublicReleases, GITHUB_REPO_URL, WEB_APP_URL } from '../../lib/releases';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const initialReleases = await fetchPublicReleases();
const rawHeroVer =
  initialReleases.channels.stable?.latest_version ||
  initialReleases.channels.beta?.latest_version ||
  '1.20';
const heroVersionTag = rawHeroVer.startsWith('v') ? rawHeroVer : `v${rawHeroVer}`;
const channelPill = locale === 'ru' ? `Релиз ${heroVersionTag}` : `Release ${heroVersionTag}`;

const c = locale === 'ru'
  ? {
      metaTitle: 'Theaver — Мессенджер для чатов, звонков и работы',
      metaDesc: 'Кроссплатформенный мессенджер с открытым клиентом: чаты с работой без сети, каналы, звонки с показом экрана, несколько панелей на ПК и боты.',
      heroTitle: 'Общение, звонки и работа в одном мессенджере',
      heroSub: 'Быстрые чаты, каналы, звонки с показом экрана, несколько окон на одном экране компьютера и встроенные боты.',
      openBrowser: 'Открыть в браузере',
      heroAlt: 'Десктопный клиент Theaver с открытыми чатами и боковой панелью',
      section1Label: 'Чаты и звонки',
      section1Title: 'На связи, даже когда интернет пропадает',
      section1Body: 'Сообщения, черновики и недавние файлы сохраняются на вашем устройстве. Если отправить ответ в метро или без сети, приложение само доставит его, как только вернётся связь.',
      section1List: [
        'Публичные каналы со счётчиком просмотров, отложенной отправкой и комментариями',
        'Группы с темами обсуждений, опросами, викторинами и настройкой прав участников',
        'Голосовые, видеокружки и групповые звонки с демонстрацией экрана до 1080p 60 fps',
      ],
      chatsAlt: 'Экран мобильного клиента Theaver со списком чатов',
      callsAlt: 'Групповой звонок и демонстрация экрана в Theaver',
      section2Label: 'Компьютер и оформление',
      section2Title: 'Удобно на большом экране и настраивается под себя',
      featureCards: [
        {
          icon: 'layers' as const,
          title: 'Несколько панелей на одном экране',
          body: 'На компьютере диалог, ветку комментариев, профиль и панель стикеров можно держать открытыми рядом без постоянных переключений.',
          href: '',
          linkLabel: '',
        },
        {
          icon: 'message' as const,
          title: 'Стикеры, GIF и перенос из Telegram',
          body: 'Анимированные стикеры, быстрый поиск по GIF-ленте и импорт ваших любимых наборов из Telegram прямо внутри приложения.',
          href: '',
          linkLabel: '',
        },
        {
          icon: 'laptop' as const,
          title: 'Свои темы и оформление',
          body: 'Светлая и тёмная палитры, выбор акцентов, фонов чата и возможность поделиться готовой темой по короткой ссылке.',
          href: '',
          linkLabel: '',
        },
        {
          icon: 'bot' as const,
          title: 'Боты и мини-приложения',
          body: 'Запускайте ботов и веб-сервисы прямо в чатах. Для разработчиков доступна привычная совместимость с Telegram Bot API.',
          href: localizePath('/docs/bots/overview-botmother', locale),
          linkLabel: 'Документация для разработчиков',
        },
      ],
      section3Badge: 'Открытый клиент',
      section3Title: 'Исходный код открыт, а сборки проверяются',
      section3Body: 'Клиент написан на открытом коде. Все установщики для Windows, macOS, Linux, Android и iOS публикуются с контрольной суммой SHA-256 и цифровой подписью.',
      allPlatformsBtn: 'Скачать приложение',
      viewSource: 'Исходники на GitHub',
      verifyGuide: 'Как проверить подпись',
    }
  : {
      metaTitle: 'Theaver — Messenger for chats, calls, and everyday work',
      metaDesc: 'Cross-platform messenger with an open client: offline-ready chats, channels, 1080p screen-sharing calls, multi-pane desktop layout, and bots.',
      heroTitle: 'Chats, calls, and your workspace in one messenger',
      heroSub: 'Fast direct messages, channels, screen-sharing calls, side-by-side desktop panes, and built-in bots.',
      openBrowser: 'Open in Browser',
      heroAlt: 'Theaver desktop client showing chat list, conversation, and side panel',
      section1Label: 'Chats & Calls',
      section1Title: 'Keeps up even when your connection drops',
      section1Body: 'Your messages, drafts, and recent media stay cached on your device. Send a reply on a train or in a dead zone, and the app delivers it automatically once you reconnect.',
      section1List: [
        'Public channels with view counts, scheduled posts, and comment threads',
        'Groups with forum topics, polls, quizzes, and clear member permissions',
        'Voice notes, round video messages, and calls with 1080p 60 fps screen sharing',
      ],
      chatsAlt: 'Theaver mobile app chat screen',
      callsAlt: 'Theaver group call and screen sharing window',
      section2Label: 'Desktop & Personalization',
      section2Title: 'Built for wide screens and tailored to your style',
      featureCards: [
        {
          icon: 'layers' as const,
          title: 'Side-by-side desktop panes',
          body: 'Keep your main chat, a comment thread, a profile card, and the sticker panel open next to each other instead of jumping back and forth.',
          href: '',
          linkLabel: '',
        },
        {
          icon: 'message' as const,
          title: 'Stickers, GIFs & Telegram import',
          body: 'Smooth animated stickers, quick GIF search with hold-to-preview, and direct sticker pack import from Telegram.',
          href: '',
          linkLabel: '',
        },
        {
          icon: 'laptop' as const,
          title: 'Custom themes you can share',
          body: 'Switch between light and dark modes, tune accent colors and chat backgrounds, and share your theme via a short link.',
          href: '',
          linkLabel: '',
        },
        {
          icon: 'bot' as const,
          title: 'Bots & Mini Apps',
          body: 'Run interactive bots and web tools directly inside conversations, backed by a Telegram-compatible Bot API for developers.',
          href: localizePath('/docs/bots/overview-botmother', locale),
          linkLabel: 'Bot developer docs',
        },
      ],
      section3Badge: 'Open Client',
      section3Title: 'Open client code and verifiable builds',
      section3Body: 'The app client source code is public on GitHub. Official installers for Windows, macOS, Linux, Android, and iOS include SHA-256 checksums and signing keys.',
      allPlatformsBtn: 'Download Theaver',
      viewSource: 'View on GitHub',
      verifyGuide: 'Verification Guide',
    };
---

<MarketingLayout title={c.metaTitle} description={c.metaDesc}>
  <!-- Section 1: Hero (Canvas) -->
  <section class="bg-[var(--bg-page)] pt-14 pb-16 lg:pt-20 lg:pb-24">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <span class="badge-warm tabular">{channelPill}</span>
        <h1 class="mt-4 text-[36px] font-semibold leading-[1.07] tracking-[-0.022em] text-[var(--text-primary)] sm:text-[48px] lg:text-[56px]">
          {c.heroTitle}
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-[17px] font-normal leading-[1.47] text-[var(--text-secondary)] sm:text-[21px] sm:leading-[1.35]">
          {c.heroSub}
        </p>

        <div class="mt-8">
          <SmartDownloadButton locale={locale} initialReleases={initialReleases} align="center">
            <a
              slot="secondary"
              href={WEB_APP_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary"
            >
              <span>{c.openBrowser}</span>
              <Icon name="arrow-up-right" size={16} />
            </a>
          </SmartDownloadButton>
        </div>
      </div>

      <div class="mx-auto mt-12 max-w-[980px] lg:mt-16">
        <ScreenshotFrame
          name="hero-desktop"
          alt={c.heroAlt}
          width={960}
          height={600}
          priority={true}
        />
      </div>
    </div>
  </section>

  <!-- Section 2: Chats, Channels & Calls (Parchment) -->
  <section id="features" class="bg-[var(--bg-alt)] py-14 lg:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-mono text-[12.5px] font-semibold tracking-tight text-[var(--accent)]">
          {c.section1Label}
        </p>
        <h2 class="mt-2 text-[30px] font-semibold leading-[1.1] tracking-[-0.02em] text-[var(--text-primary)] sm:text-[40px]">
          {c.section1Title}
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-[17px] leading-[1.47] text-[var(--text-secondary)]">
          {c.section1Body}
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl items-center gap-10 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-5">
          <div class="mx-auto max-w-[300px]">
            <ScreenshotFrame
              name="chats-mobile"
              alt={c.chatsAlt}
              width={380}
              height={640}
            />
          </div>
        </div>

        <div class="min-w-0 lg:col-span-7">
          <ul class="flex flex-col gap-3.5 text-[16px] leading-[1.47] text-[var(--text-secondary)]">
            {c.section1List.map((item) => (
              <li class="flex items-start gap-2.5">
                <Icon name="check" size={18} class="mt-1 shrink-0 text-[var(--positive)]" />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="mt-8">
            <ScreenshotFrame
              name="calls-stream"
              alt={c.callsAlt}
              width={720}
              height={460}
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Desktop, Media, Themes & Bots (Canvas) -->
  <section class="bg-[var(--bg-page)] py-14 lg:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-mono text-[12.5px] font-semibold tracking-tight text-[var(--accent)]">
          {c.section2Label}
        </p>
        <h2 class="mt-2 text-[30px] font-semibold leading-[1.1] tracking-[-0.02em] text-[var(--text-primary)] sm:text-[40px]">
          {c.section2Title}
        </h2>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-2">
        {c.featureCards.map((card) => (
          <div class="ink-card flex flex-col justify-between p-7">
            <div>
              <div class="inline-flex h-10 w-10 items-center justify-center rounded-[var(--radius-control)] border border-[var(--border-hairline)] bg-[var(--bg-raised)] text-[var(--accent)]">
                <Icon name={card.icon} size={19} />
              </div>
              <h3 class="mt-5 text-[19px] font-semibold leading-[1.24] text-[var(--text-primary)]">
                {card.title}
              </h3>
              <p class="mt-2.5 text-[15px] leading-[1.5] text-[var(--text-secondary)]">
                {card.body}
              </p>
            </div>
            {card.href && (
              <div class="mt-5">
                <a href={card.href} class="inline-flex items-center gap-1.5 text-[14px] font-semibold text-[var(--accent)] hover:underline">
                  <span>{card.linkLabel}</span>
                  <Icon name="arrow-right" size={14} />
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4: Open Client & Downloads CTA (Dark Contrast Spotlight) -->
  <section class="tile-contrast-dark py-14 lg:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <span class="badge-warm">{c.section3Badge}</span>
        <h2 class="mt-4 text-[30px] font-semibold leading-[1.1] tracking-[-0.02em] text-[var(--text-primary)] sm:text-[40px]">
          {c.section3Title}
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-[17px] leading-[1.47] text-[var(--text-secondary)]">
          {c.section3Body}
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={localizePath('/downloads', locale)} class="btn-primary">
            <Icon name="download" size={17} />
            <span>{c.allPlatformsBtn}</span>
          </a>
          <a href={WEB_APP_URL} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            <span>{c.openBrowser}</span>
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-5 text-[14px] text-[var(--text-secondary)]">
          <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-[var(--accent)] hover:underline">
            <Icon name="github" size={15} />
            <span>{c.viewSource}</span>
          </a>
          <a href={localizePath('/docs/guide/verify-downloads', locale)} class="inline-flex items-center gap-1.5 hover:text-[var(--accent)] hover:underline">
            <Icon name="shield" size={15} />
            <span>{c.verifyGuide}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
