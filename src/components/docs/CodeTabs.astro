---
interface Props {
  tabs: string[];
  id?: string;
}

const { tabs, id = `tabs-${Math.random().toString(36).slice(2, 8)}` } = Astro.props;
---

<div class="ink-card my-5 w-full min-w-0 max-w-full overflow-hidden" data-code-tabs={id}>
  <div class="flex flex-wrap items-center gap-1 border-b border-[var(--border-hairline)] bg-[var(--bg-deep)] px-3 pt-2" role="tablist">
    {tabs.map((tab, idx) => (
      <button
        type="button"
        role="tab"
        id={`${id}-tab-${idx}`}
        aria-selected={idx === 0 ? 'true' : 'false'}
        tabindex={idx === 0 ? 0 : -1}
        data-tab-index={idx}
        class:list={[
          'rounded-t-[var(--radius-chip)] border-b-2 px-3 py-1.5 font-mono text-[12px] transition-colors duration-150',
          idx === 0
            ? 'border-[var(--accent)] bg-[var(--bg-raised)] font-semibold text-[var(--text-primary)]'
            : 'border-transparent text-[var(--text-muted)] hover:text-[var(--text-secondary)]',
        ]}
      >
        {tab}
      </button>
    ))}
  </div>
  <div class="code-tabs-panels p-0 [&_.astro-code]:rounded-none [&_.astro-code]:border-0">
    <slot />
  </div>
</div>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-code-tabs]').forEach((root) => {
      if (root.getAttribute('data-bound') === '1') return;
      root.setAttribute('data-bound', '1');

      const buttons = Array.from(root.querySelectorAll('[data-tab-index]'));
      const panelsContainer = root.querySelector('.code-tabs-panels');
      if (!panelsContainer) return;
      const panels = Array.from(panelsContainer.children);

      function activate(index, moveFocus) {
        const clamped = ((index % buttons.length) + buttons.length) % buttons.length;
        buttons.forEach((btn, i) => {
          const active = i === clamped;
          btn.setAttribute('aria-selected', active ? 'true' : 'false');
          btn.setAttribute('tabindex', active ? '0' : '-1');
          btn.classList.toggle('border-[var(--accent)]', active);
          btn.classList.toggle('border-transparent', !active);
          btn.classList.toggle('bg-[var(--bg-raised)]', active);
          btn.classList.toggle('font-semibold', active);
          btn.classList.toggle('text-[var(--text-primary)]', active);
          btn.classList.toggle('text-[var(--text-muted)]', !active);
        });
        panels.forEach((panel, i) => {
          const active = i === clamped;
          panel.hidden = !active;
          panel.classList.toggle('hidden', !active);
        });
        if (moveFocus && buttons[clamped]) {
          buttons[clamped].focus();
        }
      }

      activate(0, false);
      buttons.forEach((btn, idx) => {
        btn.addEventListener('click', () => {
          activate(idx, false);
        });
        btn.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            activate(idx + 1, true);
          } else if (event.key === 'ArrowLeft') {
            event.preventDefault();
            activate(idx - 1, true);
          } else if (event.key === 'Home') {
            event.preventDefault();
            activate(0, true);
          } else if (event.key === 'End') {
            event.preventDefault();
            activate(buttons.length - 1, true);
          }
        });
      });
    });
  })();
</script>
