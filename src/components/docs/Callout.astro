---
import Icon from '../Icon.astro';

interface Props {
  type?: 'info' | 'warning' | 'tip';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const iconName = type === 'warning' ? 'warning' : type === 'tip' ? 'shield' : 'info';
const borderClass =
  type === 'warning'
    ? 'border-l-[var(--warning)]'
    : type === 'tip'
      ? 'border-l-[var(--positive)]'
      : 'border-l-[var(--accent)]';
const iconClass =
  type === 'warning'
    ? 'text-[var(--warning)]'
    : type === 'tip'
      ? 'text-[var(--positive)]'
      : 'text-[var(--accent)]';
---

<div class:list={['ink-card my-5 border-l-2 p-4', borderClass]}>
  <div class="flex items-start gap-3">
    <Icon name={iconName} size={18} class={`mt-0.5 ${iconClass}`} />
    <div class="min-w-0 flex-1 text-[14px] leading-relaxed text-[var(--text-secondary)]">
      {title && <div class="mb-1 font-semibold text-[var(--text-primary)]">{title}</div>}
      <slot />
    </div>
  </div>
</div>
