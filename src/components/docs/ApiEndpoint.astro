---
interface Props {
  method: 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE' | 'WS';
  path: string;
  auth?: string;
}

const { method, path, auth } = Astro.props;

const badgeColor =
  method === 'GET'
    ? 'text-[var(--positive)] bg-[var(--bg-raised)] border-[var(--border-hairline)]'
    : method === 'DELETE'
      ? 'text-[var(--negative)] bg-[var(--bg-raised)] border-[var(--border-hairline)]'
      : 'text-[var(--accent)] bg-[var(--bg-raised)] border-[var(--border-hairline)]';
---

<div class="ink-card my-4 flex flex-wrap items-center justify-between gap-3 px-4 py-3">
  <div class="flex min-w-0 items-center gap-3">
    <span class:list={['rounded-[var(--radius-chip)] border px-2 py-0.5 font-mono text-[12px] font-semibold', badgeColor]}>
      {method}
    </span>
    <code class="truncate font-mono text-[13.5px] text-[var(--text-primary)]">{path}</code>
  </div>
  {auth && (
    <span class="font-mono text-[12px] text-[var(--text-muted)]">{auth}</span>
  )}
</div>
