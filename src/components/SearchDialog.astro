---
import Icon from './Icon.astro';
import { UI_STRINGS, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI_STRINGS[locale].docsUi;
const placeholder = UI_STRINGS[locale].nav.searchPlaceholder;
---

<dialog
  id="search-dialog"
  closedby="any"
  aria-labelledby="search-dialog-title"
  class="m-auto w-[min(640px,calc(100vw-32px))] rounded-[var(--radius-frame)] border border-[var(--border-strong)] bg-[var(--bg-card)] p-0 text-[var(--text-primary)] shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-[2px]"
>
  <div class="flex flex-col">
    <div class="flex items-center gap-3 border-b border-[var(--border-hairline)] px-4 py-3">
      <Icon name="search" size={18} class="text-[var(--text-muted)]" />
      <label for="search-dialog-input" id="search-dialog-title" class="sr-only">
        {t.searchTitle}
      </label>
      <input
        id="search-dialog-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder={placeholder}
        class="h-9 flex-1 bg-transparent text-[15px] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none"
      />
      <button
        type="button"
        data-close-search
        aria-label={t.close}
        class="inline-flex h-9 w-9 items-center justify-center rounded-[var(--radius-control)] border border-[var(--border-hairline)] bg-[var(--bg-raised)] text-[var(--text-secondary)] transition-colors duration-150 hover:text-[var(--text-primary)]"
      >
        <Icon name="close" size={16} />
      </button>
    </div>

    <div
      id="search-dialog-results"
      data-empty-label={t.searchEmpty}
      data-no-results-label={t.searchHint}
      data-locale={locale}
      class="max-h-[420px] overflow-y-auto p-3"
    >
      <p class="px-2 py-6 text-center text-[13.5px] text-[var(--text-muted)]">
        {t.searchEmpty}
      </p>
    </div>
  </div>
</dialog>

<style is:global>
  body:has(#search-dialog[open]) {
    overflow: hidden;
  }
</style>

<script is:inline>
  (() => {
    const dialog = document.getElementById('search-dialog');
    const input = document.getElementById('search-dialog-input');
    const resultsEl = document.getElementById('search-dialog-results');
    if (!(dialog instanceof HTMLDialogElement) || !(input instanceof HTMLInputElement) || !resultsEl) {
      return;
    }

    let pagefindPromise = null;
    async function loadPagefind() {
      if (!pagefindPromise) {
        pagefindPromise = import('/pagefind/pagefind.js')
          .then(async (pf) => {
            if (pf.options) {
              await pf.options({ excerptLength: 24 });
            }
            return pf;
          })
          .catch(() => null);
      }
      return pagefindPromise;
    }

    function openSearch() {
      if (!dialog.open) {
        dialog.showModal();
      }
      input.focus();
      input.select();
      void loadPagefind();
    }

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      if (target.closest('[data-open-search]')) {
        openSearch();
        return;
      }
      if (target.closest('[data-close-search]')) {
        dialog.close();
      }
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (dialog.open) {
          dialog.close();
        } else {
          openSearch();
        }
      }
    });

    // Mandatory fallback for browsers without <dialog closedby="any"> support (e.g. Safari)
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const isDialogContent =
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width;
        if (isDialogContent) return;
        dialog.close();
      });
    }

    function renderMessage(text) {
      resultsEl.replaceChildren();
      const p = document.createElement('p');
      p.className = 'px-2 py-6 text-center text-[13.5px] text-[var(--text-muted)]';
      p.textContent = text;
      resultsEl.appendChild(p);
    }

    let searchTimer = null;
    input.addEventListener('input', () => {
      const query = input.value.trim();
      if (searchTimer) clearTimeout(searchTimer);

      if (!query) {
        renderMessage(resultsEl.getAttribute('data-empty-label') || '');
        return;
      }

      searchTimer = setTimeout(async () => {
        const pf = await loadPagefind();
        if (!pf) {
          renderMessage(resultsEl.getAttribute('data-no-results-label') || '');
          return;
        }
        const search = await pf.search(query);
        const locale = resultsEl.getAttribute('data-locale') || 'en';
        const items = await Promise.all(search.results.slice(0, 12).map((r) => r.data()));

        // Prefer results matching active locale when available
        const filtered = items.filter((item) => {
          const isRu = item.url.startsWith('/ru/');
          return locale === 'ru' ? isRu : !isRu;
        });
        const list = (filtered.length > 0 ? filtered : items).slice(0, 8);

        if (list.length === 0) {
          renderMessage(resultsEl.getAttribute('data-no-results-label') || '');
          return;
        }

        const ul = document.createElement('ul');
        ul.className = 'flex flex-col gap-1';
        for (const item of list) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = item.url;
          a.className =
            'block rounded-[var(--radius-control)] border border-transparent px-3 py-2.5 transition-colors duration-150 hover:border-[var(--border-hairline)] hover:bg-[var(--bg-raised)]';
          a.addEventListener('click', () => dialog.close());

          const titleEl = document.createElement('div');
          titleEl.className = 'text-[14px] font-medium text-[var(--text-primary)]';
          titleEl.textContent = item.meta?.title || item.url;

          const urlEl = document.createElement('div');
          urlEl.className = 'mt-0.5 font-mono text-[11.5px] text-[var(--text-muted)]';
          urlEl.textContent = item.url;

          const snippetEl = document.createElement('div');
          snippetEl.className = 'mt-1 text-[13px] leading-snug text-[var(--text-secondary)]';
          snippetEl.textContent = (item.excerpt || '').replace(/<[^>]+>/g, '');

          a.append(titleEl, urlEl, snippetEl);
          li.appendChild(a);
          ul.appendChild(li);
        }

        resultsEl.replaceChildren(ul);
      }, 120);
    });
  })();
</script>
