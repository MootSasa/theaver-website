---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="70 56 286 336"
  width={size}
  height={size}
  aria-hidden="true"
  class:list={['shrink-0', interactive && 'stoat-reactive', className]}
>
  <defs>
    <mask id={maskId} maskUnits="userSpaceOnUse" x="70" y="56" width="286" height="336">
      <rect x="70" y="56" width="286" height="336" fill="#ffffff" />
      <path d={eyeCutoutD} fill="#000000" />
    </mask>
  </defs>

  {variant === 'mono' ? (
    <g class="stoat-figure" mask={`url(#${maskId})`} fill="currentColor">
      <path d={frontPawD} />
      <path d={mainSilhouetteD} />
    </g>
  ) : (
    <g class="stoat-figure" mask={`url(#${maskId})`}>
      <path d={frontPawD} fill="#ffb37f" />
      <path d={mainSilhouetteD} fill="#ffb37f" />
      <path d={neckChestD} fill="#f7ecca" />
      <path d={backStripeD} fill="#f7ecca" />
      <path d={throatCreamD} fill="#f7ecca" />
      <path d={tailHighlightD} fill="#f7ecca" />
    </g>
  )}
</svg>

<style is:global>
  .stoat-reactive {
    transform-origin: 50% 82%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .stoat-reactive {
      transition: transform 280ms var(--ease-spring, ease-out);
    }

    .stoat-reactive:hover,
    [data-stoat-scope]:has(.btn-primary:hover, .btn-primary:focus-visible, a:hover, a:focus-visible) .stoat-reactive {
      transform: translate3d(0, -3px, 0) rotate(-5deg) scale(1.04);
    }
  }
</style>
